@model project_PRN232.Frontend.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Hệ thống";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card shadow-sm border-0 border-start border-4 border-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">TỔNG SINH VIÊN</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalStudents</div>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3">
                        <i class="fa-solid fa-user-graduate fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm border-0 border-start border-4 border-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">TỔNG GIẢNG VIÊN</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalLecturers</div>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success rounded-3 p-3">
                        <i class="fa-solid fa-chalkboard-user fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm border-0 border-start border-4 border-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">LỚP HỌC PHẦN</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalSections</div>
                    </div>
                    <div class="stat-icon bg-info-subtle text-info rounded-3 p-3">
                        <i class="fa-solid fa-layer-group fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card shadow-sm border-0 border-start border-4 border-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">GPA TRUNG BÌNH</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.AverageGpa.ToString("F2")</div>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-3">
                        <i class="fa-solid fa-star fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Phân bố học lực -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="card-title mb-0 fw-bold"><i class="fa-solid fa-chart-column text-primary me-2"></i>Phân Bố Xếp Loại Học Lực Sinh Viên</h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3 py-2">
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-success"><i class="fa-solid fa-medal me-1"></i>Xuất sắc (&ge; 9.0)</span>
                            <span class="badge bg-success-subtle text-success">1 SV (33.3%)</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 33.3%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-info"><i class="fa-solid fa-award me-1"></i>Giỏi (8.0 - 8.9)</span>
                            <span class="badge bg-info-subtle text-info">2 SV (66.7%)</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: 66.7%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-primary"><i class="fa-solid fa-thumbs-up me-1"></i>Khá (7.0 - 7.9)</span>
                            <span class="badge bg-primary-subtle text-primary">0 SV (0%)</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-warning"><i class="fa-solid fa-circle-check me-1"></i>Trung bình (5.0 - 6.9)</span>
                            <span class="badge bg-warning-subtle text-warning">0 SV (0%)</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>Yếu (&lt; 5.0)</span>
                            <span class="badge bg-danger-subtle text-danger">0 SV (0%)</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cảnh báo & Tình trạng học kỳ -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="card-title mb-0 fw-bold"><i class="fa-solid fa-bell text-danger me-2"></i>Cảnh Báo & Điều Hành Kỳ</h6>
            </div>
            <div class="card-body">
                <div class="alert alert-light border d-flex align-items-center mb-3">
                    <i class="fa-solid fa-calendar-check text-primary fa-lg me-3"></i>
                    <div>
                        <div class="small text-muted">Học kỳ hiện tại</div>
                        <div class="fw-bold">@(!string.IsNullOrEmpty(Model.ActiveSemesterName) ? Model.ActiveSemesterName : "Summer 2025 (SU25)")</div>
                    </div>
                </div>

                <div class="list-group list-group-flush small">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>Lớp chưa có giảng viên:</span>
                        <span class="badge @(Model.SectionsLackingLecturer > 0 ? "bg-danger" : "bg-success") rounded-pill">
                            @Model.SectionsLackingLecturer
                        </span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="fa-solid fa-clipboard-question text-danger me-2"></i>Lớp chưa nhập đủ điểm:</span>
                        <span class="badge @(Model.SectionsLackingGrades > 0 ? "bg-warning text-dark" : "bg-success") rounded-pill">
                            @Model.SectionsLackingGrades
                        </span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="fa-solid fa-user-xmark text-secondary me-2"></i>Ngoại lệ chưa phân bổ:</span>
                        <span class="badge @(Model.UnallocatedExceptions > 0 ? "bg-danger" : "bg-success") rounded-pill">
                            @Model.UnallocatedExceptions
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

