@model project_PRN232.Frontend.Models.DashboardViewModel
@{
    var isLecturer = Model.LecturerDashboard != null;
    ViewData["Title"] = isLecturer ? "Tổng quan Giảng viên" : "Tổng quan Hệ thống";
}

@if (isLecturer && Model.LecturerDashboard != null)
{
    var lecturer = Model.LecturerDashboard;
    var completionRate = lecturer.TotalAssignedSections > 0 
        ? Math.Round((decimal)lecturer.SectionsLockedCount / lecturer.TotalAssignedSections * 100, 1) 
        : 0;

    <!-- Banner chào mừng Giảng viên -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="card-body py-3 px-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 52px; height: 52px; font-size: 22px; min-width: 52px;">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white text-primary fw-bold px-3 py-1 rounded-pill shadow-sm">
                                <i class="fa-solid fa-graduation-cap me-1"></i>@lecturer.AcademicTitle
                            </span>
                            <span class="badge bg-info text-white fw-bold px-3 py-1 rounded-pill">
                                Mã GV: @lecturer.LecturerCode
                            </span>
                        </div>
                        <h4 class="fw-bold mb-1">Xin chào, @lecturer.AcademicTitle @lecturer.FullName</h4>
                        <div class="small text-white-50">
                            <span><i class="fa-solid fa-building me-1"></i>Bộ môn: <strong>@lecturer.Department</strong></span>
                            <span class="mx-2">|</span>
                            <span><i class="fa-solid fa-chalkboard me-1"></i>Lớp đang dạy: <strong>@lecturer.TotalAssignedSections lớp</strong></span>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Grades" class="btn btn-light btn-sm text-primary fw-bold shadow-sm px-3 py-2 rounded-3">
                        <i class="fa-solid fa-pen-to-square me-1"></i>Vào Sổ Điểm
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Thẻ KPI cá nhân của Giảng viên -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-primary rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Lớp Đang Dạy</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@lecturer.TotalAssignedSections <span class="fs-6 fw-normal text-muted">lớp</span></div>
                            <div class="small text-muted mt-1"><i class="fa-solid fa-clock-rotate-left me-1"></i>Các học kỳ đang mở</div>
                        </div>
                        <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3">
                            <i class="fa-solid fa-chalkboard fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-success rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Sinh Viên Đang Dạy</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@lecturer.TotalStudentsTeaching <span class="fs-6 fw-normal text-muted">SV</span></div>
                            <div class="small text-success mt-1"><i class="fa-solid fa-check me-1"></i>Đang theo học thực tế</div>
                        </div>
                        <div class="stat-icon bg-success-subtle text-success rounded-3 p-3">
                            <i class="fa-solid fa-users-line fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-info rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Tiến Độ Khóa Điểm</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@lecturer.SectionsLockedCount / @lecturer.TotalAssignedSections <span class="fs-6 fw-normal text-muted">(@completionRate%)</span></div>
                            <div class="small @(lecturer.SectionsPendingGradeCount > 0 ? "text-warning" : "text-success") mt-1">
                                <i class="fa-solid @(lecturer.SectionsPendingGradeCount > 0 ? "fa-clock" : "fa-circle-check") me-1"></i>
                                @(lecturer.SectionsPendingGradeCount > 0 ? $"Còn {lecturer.SectionsPendingGradeCount} lớp chưa khóa" : "Đã khóa đủ")
                            </div>
                        </div>
                        <div class="stat-icon bg-info-subtle text-info rounded-3 p-3">
                            <i class="fa-solid fa-clipboard-check fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-warning rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Môn Đã Đăng Ký</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@lecturer.TotalRegisteredSubjects <span class="fs-6 fw-normal text-muted">môn</span></div>
                            <div class="small text-muted mt-1"><i class="fa-solid fa-book me-1"></i>Đã phê duyệt giảng dạy</div>
                        </div>
                        <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-3">
                            <i class="fa-solid fa-book-bookmark fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng nội dung chính: Bảng Lớp học phần đang dạy & Phổ điểm sinh viên -->
    <div class="row g-3">
        <!-- Cột trái: Bảng danh sách Lớp học phần đang giảng dạy -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="card-title mb-0 fw-bold">
                        <i class="fa-solid fa-chalkboard-user text-primary me-2"></i>Các Lớp Học Phần Đang Giảng Dạy
                    </h6>
                    <span class="badge bg-primary-subtle text-primary">@lecturer.AssignedSections.Count lớp</span>
                </div>
                <div class="card-body p-0">
                    @if (lecturer.AssignedSections != null && lecturer.AssignedSections.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th class="ps-3 text-center" style="width: 45px;">#</th>
                                        <th style="min-width: 140px; white-space: nowrap;">Mã Lớp HP</th>
                                        <th style="min-width: 130px; white-space: nowrap;">Học kỳ</th>
                                        <th style="min-width: 220px;">Môn học</th>
                                        <th style="min-width: 175px;">Lịch học & Phòng</th>
                                        <th class="text-center" style="white-space: nowrap;">Sĩ số</th>
                                        <th class="text-center" style="white-space: nowrap;">Trạng thái điểm</th>
                                        <th class="text-end pe-3" style="width: 160px; white-space: nowrap;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int stt = 1; }
                                    @foreach (var sec in lecturer.AssignedSections)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                            <td>
                                                <span class="fw-bold text-primary font-monospace">@sec.Code</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-dark border">
                                                    @(!string.IsNullOrEmpty(sec.SemesterName) ? sec.SemesterName : "Đang mở")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@sec.SubjectName</div>
                                                <div class="small text-muted">Mã: @sec.SubjectCode | @sec.Credits TC</div>
                                            </td>
                                            <td>
                                                <div class="small"><i class="fa-regular fa-clock text-secondary me-1"></i>@sec.ScheduleSummary</div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">
                                                    <i class="fa-solid fa-users me-1 text-primary"></i>@sec.StudentCount / @sec.MaxCapacity
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (sec.IsGradeLocked)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                        <i class="fa-solid fa-lock-open me-1"></i>Đang nhập
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <a href="/Grades?sectionId=@sec.Id" class="btn btn-sm btn-outline-primary" title="Vào sổ điểm lớp này">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i>Điểm
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">Hiện tại thầy/cô không có lớp học phần nào đang giảng dạy (các lớp học kỳ trước đã kết thúc).</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Phổ điểm sinh viên đang dạy -->
        <div class="col-lg-4 d-flex flex-column gap-3">
            <!-- Thẻ Phổ điểm sinh viên do giảng viên phụ trách -->
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="card-title mb-0 fw-bold">
                        <i class="fa-solid fa-chart-pie text-success me-2"></i>Phổ Điểm Sinh Viên Đang Dạy
                    </h6>
                    <span class="badge bg-success-subtle text-success fw-bold">
                        GPA TB: @lecturer.AverageTeachingScore.ToString("F2")
                    </span>
                </div>
                <div class="card-body">
                    @if (lecturer.GradeDistribution != null && lecturer.GradeDistribution.Any())
                    {
                        <div class="d-flex flex-column gap-3 py-1">
                            @foreach (var item in lecturer.GradeDistribution)
                            {
                                var barColor = "bg-primary";
                                var icon = "fa-star";
                                if (item.Rank.Contains("Xuất sắc")) { barColor = "bg-success"; icon = "fa-medal"; }
                                else if (item.Rank.Contains("Giỏi")) { barColor = "bg-info"; icon = "fa-award"; }
                                else if (item.Rank.Contains("Khá")) { barColor = "bg-primary"; icon = "fa-thumbs-up"; }
                                else if (item.Rank.Contains("Trung bình")) { barColor = "bg-warning"; icon = "fa-circle-check"; }
                                else if (item.Rank.Contains("Yếu")) { barColor = "bg-danger"; icon = "fa-triangle-exclamation"; }

                                <div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-semibold small"><i class="fa-solid @icon me-1 text-muted"></i>@item.Rank</span>
                                        <span class="badge @barColor-subtle text-dark">@item.Count SV (@item.Percentage%)</span>
                                    </div>
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar @barColor" role="progressbar" style="width: @item.Percentage%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="fa-solid fa-chart-simple fa-2x mb-2 text-muted"></i>
                            <div>Chưa có dữ liệu điểm sinh viên kỳ này</div>
                        </div>
                    }

                    <div class="mt-4 p-3 bg-light rounded-3 small text-muted">
                        <div class="fw-bold text-dark mb-1">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>Quy chế đào tạo:
                        </div>
                        <div>Các lớp học phần khi học kỳ kết thúc sẽ được tự động chuyển vào lưu trữ. Thầy/cô có thể tra cứu toàn bộ lịch sử điểm tại mục <strong>Nhập điểm lớp học</strong>.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Giao diện Tổng quan Hệ thống dành cho Quản trị viên (Admin) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-primary rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">TỔNG SINH VIÊN</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalStudents</div>
                            <div class="small text-muted mt-1"><i class="fa-solid fa-users me-1"></i>Hồ sơ sinh viên</div>
                        </div>
                        <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-3">
                            <i class="fa-solid fa-user-graduate fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-success rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">TỔNG GIẢNG VIÊN</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalLecturers</div>
                            <div class="small text-muted mt-1"><i class="fa-solid fa-chalkboard-user me-1"></i>Cán bộ giảng dạy</div>
                        </div>
                        <div class="stat-icon bg-success-subtle text-success rounded-3 p-3">
                            <i class="fa-solid fa-chalkboard-user fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-info rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">LỚP HỌC PHẦN</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalSections</div>
                            <div class="small text-muted mt-1"><i class="fa-solid fa-layer-group me-1"></i>Tổng số lớp mở</div>
                        </div>
                        <div class="stat-icon bg-info-subtle text-info rounded-3 p-3">
                            <i class="fa-solid fa-layer-group fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 border-start border-4 border-warning rounded-3 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">GPA TRUNG BÌNH</div>
                            <div class="fs-3 fw-bold text-dark mt-1">@Model.AverageGpa.ToString("F2")</div>
                            <div class="small text-muted mt-1"><i class="fa-solid fa-star me-1 text-warning"></i>Toàn hệ thống</div>
                        </div>
                        <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-3">
                            <i class="fa-solid fa-star fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Phân bố học lực -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="card-title mb-0 fw-bold">
                        <i class="fa-solid fa-chart-column text-primary me-2"></i>Phân Bố Xếp Loại Học Lực Sinh Viên
                    </h6>
                    <span class="badge bg-primary-subtle text-primary fw-semibold">GPA TB: @Model.AverageGpa.ToString("F2")</span>
                </div>
                <div class="card-body">
                    @if (Model.GpaDistribution != null && Model.GpaDistribution.Any())
                    {
                        <div class="d-flex flex-column gap-3 py-2">
                            @foreach (var item in Model.GpaDistribution)
                            {
                                var barColor = "bg-primary";
                                var textColor = "text-primary";
                                var icon = "fa-star";
                                if (item.Rank.Contains("Xuất sắc")) { barColor = "bg-success"; textColor = "text-success"; icon = "fa-medal"; }
                                else if (item.Rank.Contains("Giỏi")) { barColor = "bg-info"; textColor = "text-info"; icon = "fa-award"; }
                                else if (item.Rank.Contains("Khá")) { barColor = "bg-primary"; textColor = "text-primary"; icon = "fa-thumbs-up"; }
                                else if (item.Rank.Contains("Trung bình")) { barColor = "bg-warning"; textColor = "text-warning"; icon = "fa-circle-check"; }
                                else if (item.Rank.Contains("Yếu")) { barColor = "bg-danger"; textColor = "text-danger"; icon = "fa-triangle-exclamation"; }

                                <div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-semibold @textColor small"><i class="fa-solid @icon me-1"></i>@item.Rank</span>
                                        <span class="badge @barColor-subtle text-dark">@item.Count SV (@item.Percentage%)</span>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar @barColor" role="progressbar" style="width: @item.Percentage%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-chart-simple fa-3x mb-2 text-muted"></i>
                            <div class="fw-semibold">Chưa có dữ liệu phân bố điểm sinh viên</div>
                            <small class="text-muted">Dữ liệu sẽ được cập nhật tự động khi có điểm sinh viên trong học kỳ.</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cảnh báo & Tình trạng học kỳ -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="card-header bg-white py-3">
                        <h6 class="card-title mb-0 fw-bold"><i class="fa-solid fa-bell text-danger me-2"></i>Cảnh Báo & Điều Hành Kỳ</h6>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-light border d-flex align-items-center mb-3">
                            <i class="fa-solid fa-calendar-check text-primary fa-lg me-3"></i>
                            <div>
                                <div class="small text-muted">Học kỳ hiện tại</div>
                                <div class="fw-bold">@(!string.IsNullOrEmpty(Model.ActiveSemesterName) ? Model.ActiveSemesterName : "Summer 2025 (SU25)")</div>
                            </div>
                        </div>

                        <div class="list-group list-group-flush small mb-3">
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>Lớp chưa có giảng viên:</span>
                                <span class="badge @(Model.SectionsLackingLecturer > 0 ? "bg-danger" : "bg-success") rounded-pill">
                                    @Model.SectionsLackingLecturer
                                </span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="fa-solid fa-clipboard-question text-danger me-2"></i>Lớp chưa khóa đủ điểm:</span>
                                <span class="badge @(Model.SectionsLackingGrades > 0 ? "bg-warning text-dark" : "bg-success") rounded-pill">
                                    @Model.SectionsLackingGrades
                                </span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="fa-solid fa-user-xmark text-secondary me-2"></i>Ngoại lệ chưa phân bổ:</span>
                                <span class="badge @(Model.UnallocatedExceptions > 0 ? "bg-danger" : "bg-success") rounded-pill">
                                    @Model.UnallocatedExceptions
                                </span>
                            </div>
                        </div>

                        <!-- Lối tắt thao tác nhanh -->
                        <div class="p-3 bg-light rounded-3">
                            <div class="fw-bold text-dark small mb-2"><i class="fa-solid fa-bolt text-warning me-1"></i>Thao tác điều hành nhanh:</div>
                            <div class="d-grid gap-2">
                                <a href="/Grades" class="btn btn-outline-primary btn-sm text-start">
                                    <i class="fa-solid fa-pen-to-square me-2"></i>Sổ nhập & khóa điểm
                                </a>
                                <a href="/Semesters" class="btn btn-outline-secondary btn-sm text-start">
                                    <i class="fa-solid fa-layer-group me-2"></i>Quản lý Lớp học phần
                                </a>
                                <a href="/Classes/Allocations" class="btn btn-outline-success btn-sm text-start">
                                    <i class="fa-solid fa-users-gear me-2"></i>Phân bổ vào lớp hành chính
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
