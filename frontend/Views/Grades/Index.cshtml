@model project_PRN232.Frontend.Models.GradeSheetViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Quản lý Bảng điểm Lớp Học phần";
    var role = HttpContextAccessor.HttpContext?.Session.GetString("SMMS_USER_ROLE") ?? "";
    bool isLecturer = (role == "Lecturer");

    var lecturerSections = (List<project_PRN232.Frontend.Models.CourseSectionViewModel>)ViewBag.LecturerSections ?? new();
    var adminClasses = (List<project_PRN232.Frontend.Models.ClassViewModel>)ViewBag.AdministrativeClasses ?? new();
    var allClasses = (List<project_PRN232.Frontend.Models.ClassViewModel>)ViewBag.AllClasses ?? adminClasses;
    var sections = (List<project_PRN232.Frontend.Models.CourseSectionViewModel>)ViewBag.Sections ?? new();
    var selectedClass = ViewBag.SelectedClass as project_PRN232.Frontend.Models.ClassSectionsResponseViewModel;
    int? selectedClassId = ViewBag.SelectedClassId as int?;
    int? selectedSectionId = ViewBag.SelectedSectionId as int?;
    string classSearch = ViewBag.ClassSearch as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
    <div>
        @if (isLecturer)
        {
            <h4 class="fw-bold mb-1 text-primary"><i class="fa-solid fa-pen-to-square me-2"></i>Nhập điểm Lớp học phần phụ trách</h4>
            <small class="text-muted">Chọn lớp học phần bạn đang phụ trách để xem danh sách sinh viên và nhập điểm thành phần theo CTĐT.</small>
        }
        else
        {
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-marker text-primary me-2"></i>Quản lý & Nhập điểm Học phần</h4>
            <small class="text-muted">Tìm kiếm theo tên lớp hành chính để xem danh sách các môn học đang học và nhập điểm thành phần theo CTĐT.</small>
        }
    </div>
    @if (Model != null && Model.CourseSectionId > 0)
    {
        <div class="d-flex gap-2">
            <a asp-controller="Reports" asp-action="ExportSectionGradesWord" asp-route-sectionId="@Model.CourseSectionId" class="btn btn-outline-primary btn-sm rounded-3 shadow-sm px-3 py-2">
                <i class="fa-solid fa-file-word me-1 text-primary"></i> Xuất Báo cáo Word
            </a>
            @if (role == "Admin")
            {
                <form asp-action="ToggleLock" method="post" class="d-inline">
                    <input type="hidden" name="sectionId" value="@Model.CourseSectionId" />
                    <input type="hidden" name="classId" value="@(selectedClassId ?? Model.AdministrativeClassId)" />
                    <input type="hidden" name="isLocked" value="@(Model.IsGradeLocked ? "false" : "true")" />
                    @if (Model.IsGradeLocked)
                    {
                        <button type="submit" class="btn btn-warning btn-sm rounded-3 shadow-sm px-3 py-2 fw-semibold" onclick="return confirm('Bạn có chắc chắn muốn mở khóa bảng điểm này để giảng viên tiếp tục cập nhật?')">
                            <i class="fa-solid fa-lock-open me-1"></i> Mở khóa Điểm
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger btn-sm rounded-3 shadow-sm px-3 py-2 fw-semibold" onclick="return confirm('Khóa bảng điểm sẽ ngăn giảng viên sửa điểm. Bạn có muốn khóa không?')">
                            <i class="fa-solid fa-lock me-1"></i> Khóa Bảng Điểm
                        </button>
                    }
                </form>
            }
        </div>
    }
</div>

@if (isLecturer)
{
    <!-- ============================================================== -->
    <!-- GIAO DIỆN CHỌN LỚP HỌC PHẦN DÀNH CHO GIẢNG VIÊN -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-3 col-lg-2 fw-semibold text-secondary">
                    <i class="fa-solid fa-chalkboard-user me-1 text-primary"></i> Lớp học phần:
                </div>
                <div class="col-md-7 col-lg-8">
                    <select name="sectionId" class="form-select py-2" onchange="this.form.submit()">
                        @if (!lecturerSections.Any())
                        {
                            <option value="">-- Bạn hiện chưa được phân công lớp học phần nào --</option>
                        }
                        else
                        {
                            @foreach (var sec in lecturerSections)
                            {
                                <option value="@sec.Id" selected="@(selectedSectionId == sec.Id ? "selected" : null)">
                                    @sec.Code - @sec.SubjectCode (@sec.SubjectName) @(sec.IsGradeLocked ? "[ĐÃ KHÓA]" : "[ĐANG MỞ CHO NHẬP]")
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 shadow-sm py-2 fw-semibold">
                        <i class="fa-solid fa-folder-open me-1"></i> Mở sổ điểm
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!lecturerSections.Any())
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="fa-solid fa-circle-info fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">Bạn chưa được phân công phụ trách lớp học phần nào</h5>
            <p class="text-muted mb-0">Vui lòng liên hệ Phòng Đào tạo (Admin) để được phân công giảng dạy các lớp học phần trong kỳ.</p>
        </div>
    }
}
else
{
    <!-- ============================================================== -->
    <!-- GIAO DIỆN TÌM KIẾM THEO LỚP HÀNH CHÍNH DÀNH CHO ADMIN -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-white px-4 py-3 border-bottom border-light">
            <h6 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-magnifying-glass text-primary me-2"></i>Tìm kiếm & Chọn Lớp Hành Chính
            </h6>
        </div>
        <div class="card-body p-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted px-3">
                            <i class="fa-solid fa-school"></i>
                        </span>
                        <input type="text" name="classSearch" value="@classSearch" class="form-control border-start-0 py-2" 
                               placeholder="Nhập tên/mã lớp (ví dụ: SE1701, SE1801, IA1701...)" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="classId" class="form-select py-2" onchange="this.form.submit()">
                        <option value="">-- Hoặc chọn từ danh sách lớp (@allClasses.Count lớp) --</option>
                        @foreach (var c in allClasses)
                        {
                            <option value="@c.Id" selected="@(selectedClassId == c.Id ? "selected" : null)">
                                @c.Code - @c.Name (@c.MajorCode, K@(c.Cohort) - Kỳ @c.CurrentSemester)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 rounded-3 py-2 fw-semibold">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm môn học
                    </button>
                    @if (selectedClassId.HasValue || !string.IsNullOrWhiteSpace(classSearch))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2 px-3" title="Đặt lại bộ lọc">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    }
                </div>
            </form>

            @if (sections != null && sections.Any())
            {
                <!-- Tùy chọn chọn trực tiếp lớp học phần -->
                <div class="mt-3 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <small class="text-muted">
                            <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                            Gợi ý: Nhập tên lớp để xem ngay các môn học lớp đó đang học. Hoặc chọn trực tiếp lớp HP:
                        </small>
                        <div style="min-width: 320px;">
                            <form method="get" asp-action="Index">
                                <select name="sectionId" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">-- Chọn trực tiếp theo Mã lớp HP --</option>
                                    @foreach (var sec in sections)
                                    {
                                        <option value="@sec.Id" selected="@(selectedSectionId == sec.Id ? "selected" : null)">
                                            @sec.Code - @sec.SubjectCode (@sec.SubjectName)
                                        </option>
                                    }
                                </select>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (selectedClass != null)
    {
        <!-- Danh sách các môn học của Lớp đã chọn -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-primary text-white p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge bg-white text-primary fs-6 fw-bold me-2 px-3 py-2 shadow-sm">
                        <i class="fa-solid fa-users-rectangle me-1"></i>@selectedClass.ClassCode
                    </span>
                    <span class="fw-bold fs-5">@selectedClass.ClassName</span>
                    <span class="badge bg-primary-subtle text-dark ms-2 py-2 px-3">Ngành @selectedClass.MajorCode</span>
                    <span class="badge bg-light text-dark ms-1 py-2 px-3">Kỳ @selectedClass.CurrentSemester</span>
                    <span class="badge bg-light text-dark ms-1 py-2 px-3">Năm học @selectedClass.AcademicYear</span>
                </div>
                <div>
                    <span class="badge bg-white text-dark py-2 px-3 shadow-sm fs-6">
                        Tổng số: <strong class="text-primary">@selectedClass.SectionsCount</strong> môn học đang học
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!selectedClass.Sections.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-book-open-reader fa-3x mb-3 text-secondary"></i>
                        <h6 class="fw-bold">Lớp này hiện chưa có môn học / lớp học phần nào!</h6>
                        <p class="small mb-0">Vui lòng kiểm tra lại cấu hình phân bổ hoặc đồng bộ môn học theo CTĐT cho lớp hành chính này.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;" class="text-center">STT</th>
                                    <th style="width: 120px;">Mã môn</th>
                                    <th>Tên môn học đang học</th>
                                    <th>Mã lớp học phần</th>
                                    <th style="width: 90px;" class="text-center">Tín chỉ</th>
                                    <th style="width: 100px;" class="text-center">Học kỳ</th>
                                    <th>Giảng viên</th>
                                    <th style="width: 130px;" class="text-center">Trạng thái điểm</th>
                                    <th style="width: 140px;" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int secIdx = 0; }
                                @foreach (var s in selectedClass.Sections)
                                {
                                    bool isCurrent = (selectedSectionId == s.Id);
                                    <tr class="@(isCurrent ? "table-primary bg-primary-subtle" : "")">
                                        <td class="text-center fw-semibold text-muted">@(secIdx + 1)</td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary border fw-bold px-2 py-1">@s.SubjectCode</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@s.SubjectName</div>
                                        </td>
                                        <td>
                                            <code class="text-primary fw-semibold">@s.Code</code>
                                        </td>
                                        <td class="text-center fw-semibold">@s.Credits TC</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@s.SemesterCode</span>
                                        </td>
                                        <td>
                                            <small><i class="fa-solid fa-user-tie me-1 text-muted"></i>@(s.LecturerName ?? "Chưa phân công")</small>
                                        </td>
                                        <td class="text-center">
                                            @if (s.IsGradeLocked)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                                    <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i>Đang mở
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (isCurrent)
                                            {
                                                <a href="#gradeEntrySection" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-semibold">
                                                    <i class="fa-solid fa-arrow-down me-1"></i> Đang chọn
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Index" asp-route-classId="@selectedClass.ClassId" asp-route-sectionId="@s.Id" 
                                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i> Vào nhập điểm
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                    secIdx++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model == null || Model.CourseSectionId == 0)
    {
        <!-- Hướng dẫn khi chưa chọn lớp -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 text-center p-5 bg-white">
            <div class="py-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-4 mb-3">
                    <i class="fa-solid fa-chalkboard-user fa-3x"></i>
                </div>
                <h5 class="fw-bold text-dark">Chọn hoặc Tìm kiếm Lớp Hành chính để Bắt đầu</h5>
                <p class="text-muted mx-auto" style="max-width: 600px;">
                    Nhập mã hoặc tên lớp hành chính (ví dụ: <code>SE1701</code>, <code>SE1801</code>, <code>IA1701</code>...) vào ô tìm kiếm ở trên để xem tất cả các môn học mà lớp đó đang học, sau đó chọn từng môn để mở bảng nhập điểm theo các đầu điểm đã thiết lập.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
                    @foreach (var c in allClasses.Take(8))
                    {
                        <a asp-action="Index" asp-route-classId="@c.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                            <i class="fa-solid fa-users me-1"></i> Lớp @c.Code
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}

<!-- ============================================================== -->
<!-- BẢNG NHẬP ĐIỂM HỌC PHẦN (DÙNG CHUNG KHI ĐÃ CÓ SECTION) -->
<!-- ============================================================== -->
@if (Model != null && Model.CourseSectionId > 0)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" id="gradeEntrySection">
        <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center border-bottom flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">@Model.SubjectCode</span>
                    <h4 class="fw-bold text-dark mb-0">@Model.SubjectName</h4>
                    @if (!string.IsNullOrEmpty(Model.AdministrativeClassCode))
                    {
                        <span class="badge bg-info-subtle text-info border border-info ms-2 px-3 py-2">
                            Lớp HC: <strong>@Model.AdministrativeClassCode</strong>
                        </span>
                    }
                </div>
                <div class="text-muted small d-flex gap-3 flex-wrap">
                    <span><i class="fa-solid fa-barcode me-1 text-primary"></i>Mã lớp HP: <strong class="text-dark">@Model.CourseSectionCode</strong></span>
                    <span><i class="fa-solid fa-award me-1 text-warning"></i>Số tín chỉ: <strong class="text-dark">@Model.Credits TC</strong></span>
                    <span><i class="fa-solid fa-user-tie me-1 text-info"></i>Giảng viên: <strong class="text-dark">@(Model.LecturerName ?? "Chưa phân công")</strong></span>
                </div>
            </div>
            <div class="text-end">
                @if (Model.IsGradeLocked)
                {
                    <span class="badge bg-danger px-3 py-2 shadow-sm fs-6 rounded-pill">
                        <i class="fa-solid fa-lock me-1"></i>BẢNG ĐIỂM ĐÃ KHÓA
                    </span>
                }
                else
                {
                    <span class="badge bg-success px-3 py-2 shadow-sm fs-6 rounded-pill">
                        <i class="fa-solid fa-pen-to-square me-1"></i>ĐANG MỞ CHO PHÉP NHẬP
                    </span>
                }
            </div>
        </div>

        <!-- Thanh Hiển thị Các Đầu Điểm Đã Cấu Hình / Đánh Dấu Tích Khi Tạo Điểm -->
        <div class="card-body bg-light py-3 px-4 border-bottom">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <span class="fw-semibold small text-muted me-2">
                    <i class="fa-solid fa-list-check text-primary me-1"></i>Các đầu điểm đã tích hợp của môn:
                </span>
                @foreach (var comp in Model.Components)
                {
                    <span class="badge bg-white text-dark border p-2 shadow-sm rounded-3">
                        <i class="fa-solid fa-circle-check text-success me-1"></i>
                        <strong>@comp.Name</strong>: @(comp.Weight.ToString("0.#"))% (Thang @comp.Scale.ToString("0"))
                        @if (comp.IsAdminOnly)
                        {
                            <span class="badge bg-danger ms-1" title="Chỉ Admin có quyền nhập/sửa đầu điểm này">
                                <i class="fa-solid fa-shield-halved me-1"></i>Chỉ Admin
                            </span>
                        }
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.StudentRows.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-users-slash fa-3x mb-3 text-secondary"></i>
                    <p class="mb-0">Chưa có sinh viên nào được phân bổ vào lớp học phần này.</p>
                </div>
            }
            else
            {
                <form asp-action="Save" method="post">
                    <input type="hidden" name="courseSectionId" value="@Model.CourseSectionId" />
                    <input type="hidden" name="classId" value="@(selectedClassId ?? Model.AdministrativeClassId)" />

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light text-center">
                                <tr>
                                    <th style="width: 50px;">STT</th>
                                    <th style="width: 120px;">MSSV</th>
                                    <th class="text-start">Họ và tên sinh viên</th>
                                    <th style="width: 110px;">Lớp HC</th>
                                    @foreach (var comp in Model.Components)
                                    {
                                        <th style="width: 130px;">
                                            <div>@comp.Name</div>
                                            <small class="badge bg-light text-dark border">@(comp.Weight.ToString("0.#"))%</small>
                                            @if (comp.IsAdminOnly)
                                            {
                                                <div><small class="badge bg-danger text-white border border-danger"><i class="fa-solid fa-shield-halved me-1"></i>Chỉ Admin</small></div>
                                            }
                                            else
                                            {
                                                <div><small class="badge bg-primary-subtle text-primary border border-primary"><i class="fa-solid fa-chalkboard-user me-1"></i>Giảng viên</small></div>
                                            }
                                        </th>
                                    }
                                    <th style="width: 110px;">Tổng kết</th>
                                    <th style="width: 120px;">Kết quả</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowIdx = 0; }
                                @foreach (var s in Model.StudentRows)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@(rowIdx + 1)</td>
                                        <td class="fw-bold text-center">
                                            <code class="text-dark">@s.StudentCode</code>
                                        </td>
                                        <td class="fw-semibold">@s.FullName</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">
                                                @(string.IsNullOrEmpty(s.AdministrativeClassCode) ? (Model.AdministrativeClassCode ?? "Chưa có") : s.AdministrativeClassCode)
                                            </span>
                                        </td>
                                        
                                        @{ int compIdx = 0; }
                                        @foreach (var comp in Model.Components)
                                        {
                                            decimal? scoreVal = null;
                                            if (s.ComponentScores != null && s.ComponentScores.ContainsKey(comp.Id))
                                            {
                                                scoreVal = s.ComponentScores[comp.Id];
                                            }
                                            
                                            // Phân quyền chuẩn xác:
                                            // - Admin CHỈ ĐƯỢC NHẬP những điểm có quyền nhập (comp.IsAdminOnly == true). Các điểm còn lại thì KHÔNG được nhập.
                                            // - Giảng viên CHỈ ĐƯỢC NHẬP những điểm của GV (comp.IsAdminOnly == false). Các điểm Chỉ Admin thì KHÔNG được nhập.
                                            bool canEditComponent = false;
                                            if (!Model.IsGradeLocked)
                                            {
                                                if (role == "Admin")
                                                {
                                                    canEditComponent = comp.IsAdminOnly;
                                                }
                                                else if (role == "Lecturer")
                                                {
                                                    canEditComponent = !comp.IsAdminOnly;
                                                }
                                            }
                                            int flatIndex = rowIdx * Model.Components.Count + compIdx;

                                            string placeholderText = "0.0";
                                            string tooltipText = $"Nhập điểm từ 0.0 đến {comp.Scale.ToString("0")}";
                                            string cellClass = "";

                                            if (!canEditComponent)
                                            {
                                                if (role == "Admin" && !comp.IsAdminOnly)
                                                {
                                                    placeholderText = "GV chấm";
                                                    tooltipText = "Đầu điểm này do Giảng viên phụ trách chấm và nhập (Admin không nhập)";
                                                    cellClass = "bg-light-subtle";
                                                }
                                                else if (role != "Admin" && comp.IsAdminOnly)
                                                {
                                                    placeholderText = "Chỉ Admin";
                                                    tooltipText = "Đầu điểm này chỉ Admin / Hội đồng có quyền nhập";
                                                    cellClass = "bg-danger-subtle";
                                                }
                                            }

                                            <td class="text-center p-1 @cellClass">
                                                @if (canEditComponent)
                                                {
                                                    <input type="hidden" name="grades[@flatIndex].StudentId" value="@s.StudentId" />
                                                    <input type="hidden" name="grades[@flatIndex].ComponentId" value="@comp.Id" />
                                                    <input type="number" step="0.1" min="0" max="@comp.Scale.ToString("0")" 
                                                           name="grades[@flatIndex].Score" 
                                                           value="@(scoreVal.HasValue ? scoreVal.Value.ToString("0.0") : "")"
                                                           class="form-control form-control-sm text-center fw-semibold text-primary"
                                                           placeholder="@placeholderText"
                                                           title="@tooltipText" />
                                                }
                                                else
                                                {
                                                    <input type="text" 
                                                           value="@(scoreVal.HasValue ? scoreVal.Value.ToString("0.0") : "")"
                                                           class="form-control form-control-sm text-center bg-light text-muted fw-semibold"
                                                           placeholder="@placeholderText"
                                                           title="@tooltipText"
                                                           readonly disabled />
                                                }
                                            </td>
                                            compIdx++;
                                        }

                                        <td class="text-center fw-bold fs-6 @(s.FinalScore.HasValue ? (s.IsPassed ? "text-success" : "text-danger") : "text-muted")">
                                            @(s.FinalScore.HasValue ? s.FinalScore.Value.ToString("0.0") : "-")
                                            @if (!s.IsCompleted && s.FinalScore.HasValue)
                                            {
                                                <div class="text-muted small" style="font-size: 0.72rem; font-weight: normal;">(Tạm tính)</div>
                                            }
                                        </td>
                                        <td class="text-center py-3 px-2">
                                            @if (s.IsCompleted && s.FinalScore.HasValue)
                                            {
                                                if (s.IsPassed)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill fw-semibold">
                                                        <i class="fa-solid fa-circle-check me-1"></i>ĐẠT
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 rounded-pill fw-semibold">
                                                        <i class="fa-solid fa-circle-xmark me-1"></i>HỎNG
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 rounded-pill fw-semibold" title="Chưa nhập đủ tất cả các đầu điểm">
                                                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Chưa đủ điểm
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                    rowIdx++;
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white p-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <small class="text-muted d-block">
                                <i class="fa-solid fa-circle-info me-1 text-primary"></i> Điểm lẻ từ 0.0 đến 10.0. Điểm tổng kết tự động tính theo tỷ trọng % các đầu điểm đã tích hợp. Điểm đạt &ge; 5.0.
                            </small>
                            @if (!isLecturer && selectedClass != null)
                            {
                                <small class="text-primary mt-2 d-inline-block">
                                    <a asp-action="Index" asp-route-classId="@selectedClass.ClassId" class="text-decoration-none fw-semibold">
                                        <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách môn học của lớp @selectedClass.ClassCode
                                    </a>
                                </small>
                            }
                        </div>
                        @if (!Model.IsGradeLocked)
                        {
                            <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 shadow-sm fw-semibold">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Bảng Điểm
                            </button>
                        }
                    </div>
                </form>
            }
        </div>
    </div>
}
