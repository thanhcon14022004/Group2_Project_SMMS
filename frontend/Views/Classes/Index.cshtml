</div>

@section Scripts {
<script>
    const specializationsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(specializations.Select(s => new {
        id = s.Id,
        majorId = s.MajorId,
        code = s.Code,
        name = s.Name
    })));

    function onAddClassMajorChange() {
        const majorSelect = document.getElementById('addClassMajorId');
        const specSelect = document.getElementById('addClassSpecId');
        if (!majorSelect || !specSelect) return;

        const majorId = parseInt(majorSelect.value) || 0;
        specSelect.innerHTML = '<option value="">-- Không chọn (Cơ sở ngành) --</option>';

        if (majorId > 0) {
            const filtered = specializationsData.filter(s => s.majorId === majorId);
            filtered.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.id;
                opt.textContent = `Ngành hẹp: ${s.code} - ${s.name}`;
                specSelect.appendChild(opt);
            });
        }
    }

    function fillClassSample(code, majorId) {
        document.getElementById('addClassCode').value = code;
        if (majorId) {
            document.getElementById('addClassMajorId').value = majorId;
            onAddClassMajorChange();
        }
    }

    function openEditClassModal(id, code, name, year, sem, specId, isActive) {
        document.getElementById('editClassId').value = id;
        document.getElementById('editClassCodeBadge').innerText = code;
        document.getElementById('editClassName').value = name;
        document.getElementById('editClassAcademicYear').value = year;
        document.getElementById('editClassSemester').value = sem;
        document.getElementById('editClassSpecId').value = specId ? specId : '';
        document.getElementById('editClassActive').checked = isActive;
        new bootstrap.Modal(document.getElementById('modalEditClass')).show();
    }

    let currentViewedClass = { id: 0, code: '', majorCode: '', semester: 1, specCode: '' };
    let currentAssignmentData = null;

    function openClassSectionsModal(classId, classCode, semester, academicYear, majorCode, specCode) {
        currentViewedClass = { id: classId, code: classCode, majorCode: majorCode, semester: semester, specCode: specCode };
        document.getElementById('sectionsClassCodeBadge').innerText = classCode;
        document.getElementById('syncClassId').value = classId;
        const specInfo = specCode ? ` (Ngành hẹp: ${specCode})` : '';
        document.getElementById('sectionsClassSubTitle').innerText = `Ngành: ${majorCode}${specInfo} | Kỳ ${semester} | Học phần: ${academicYear}`;
        
        document.getElementById('sectionsLoading').style.display = 'block';
        document.getElementById('sectionsContent').style.display = 'none';
        document.getElementById('sectionsEmpty').style.display = 'none';

        new bootstrap.Modal(document.getElementById('modalClassSections')).show();

        fetch(`/Classes/GetSections?id=${classId}`)
            .then(res => res.json())
            .then(res => {
                document.getElementById('sectionsLoading').style.display = 'none';
                if (res.success && res.data && res.data.sections && res.data.sections.length > 0) {
                    const sections = res.data.sections;
                    document.getElementById('sectionsCountBadge').innerText = sections.length;
                    const tbody = document.getElementById('sectionsTableBody');
                    tbody.innerHTML = '';
                    sections.forEach((s, idx) => {
                        const scheds = (s.schedules && s.schedules.length > 0)
                            ? s.schedules.map(sc => `${sc.dayOfWeekStr} Slot ${sc.slot} (${sc.room})`).join('<br/>')
                            : '<span class="text-muted small">Chưa xếp</span>';

                        const lecturerBadge = (s.lecturerName && s.lecturerName !== 'Chưa phân công')
                            ? `<span class="badge bg-success-subtle text-success border border-success"><i class="fa-solid fa-user-tie me-1"></i>${s.lecturerName}</span>`
                            : `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>Chưa phân công</span>`;

                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="text-center text-muted">${idx + 1}</td>
                            <td class="fw-bold text-primary">${s.subjectCode}</td>
                            <td>${s.subjectName}</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">${s.credits} TC</span></td>
                            <td><code class="text-dark bg-light px-2 py-1 rounded border">${s.code}</code></td>
                            <td class="small">${scheds}</td>
                            <td class="small">${lecturerBadge}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                    document.getElementById('sectionsContent').style.display = 'block';
                } else {
                    document.getElementById('sectionsEmpty').style.display = 'block';
                }
            })
            .catch(err => {
                document.getElementById('sectionsLoading').style.display = 'none';
                document.getElementById('sectionsEmpty').style.display = 'block';
                document.getElementById('sectionsEmpty').innerText = 'Không thể tải danh sách môn học: ' + err;
            });
    }

    function switchToAssignLecturersModal() {
        bootstrap.Modal.getInstance(document.getElementById('modalClassSections'))?.hide();
        openAssignLecturersModal(currentViewedClass.id, currentViewedClass.code, currentViewedClass.majorCode, currentViewedClass.semester, currentViewedClass.specCode);
    }

    function openAssignLecturersModal(classId, classCode, majorCode, semester, specCode) {
        document.getElementById('assignClassId').value = classId;
        document.getElementById('assignClassCodeBadge').innerText = classCode;
        const specInfo = specCode ? ` (Ngành hẹp: ${specCode})` : ' (Cơ sở ngành)';
        document.getElementById('assignClassSubTitle').innerText = `Ngành: ${majorCode}${specInfo} | Kỳ học: ${semester}`;

        document.getElementById('assignLoading').style.display = 'block';
        document.getElementById('assignContent').style.display = 'none';
        document.getElementById('assignEmpty').style.display = 'none';

        new bootstrap.Modal(document.getElementById('modalAssignLecturers')).show();

        fetch(`/Classes/GetLecturersAssignment?id=${classId}`)
            .then(res => res.json())
            .then(res => {
                document.getElementById('assignLoading').style.display = 'none';
                if (res.success && res.data && res.data.sections && res.data.sections.length > 0) {
                    currentAssignmentData = res.data;
                    const sections = res.data.sections;
                    const lecturers = res.data.lecturers;
                    const tbody = document.getElementById('assignTableBody');
                    tbody.innerHTML = '';

                    sections.forEach((s, idx) => {
                        const scheds = (s.schedules && s.schedules.length > 0)
                            ? s.schedules.map(sc => `${sc.dayOfWeekStr} Slot ${sc.slot} (${sc.room})`).join(', ')
                            : '<span class="text-muted small">Chưa xếp</span>';

                        // Chỉ list ra các giảng viên có đăng ký dạy môn này
                        const qualified = lecturers.filter(l => 
                            l.registeredSubjectIds && l.registeredSubjectIds.includes(s.subjectId)
                        );

                        let optionsHtml = '';
                        let warningBadge = '';

                        if (qualified.length > 0) {
                            optionsHtml = '<option value="">-- Chưa phân công --</option>';
                            qualified.forEach(l => {
                                const sel = (s.lecturerId === l.id) ? 'selected' : '';
                                const matchNote = l.isPreferred ? '⭐ ' : '';
                                optionsHtml += `<option value="${l.id}" data-preferred="${l.isPreferred}" ${sel}>${matchNote}${l.academicTitle}. ${l.fullName} (${l.lecturerCode} - ${l.department})</option>`;
                            });
                        } else {
                            const currentAssigned = lecturers.find(l => l.id === s.lecturerId);
                            if (currentAssigned) {
                                optionsHtml = `<option value="${currentAssigned.id}" selected>${currentAssigned.academicTitle}. ${currentAssigned.fullName} (${currentAssigned.lecturerCode})</option>`;
                                optionsHtml += '<option value="" disabled class="text-danger">⚠️ Môn này chưa có thêm GV đăng ký</option>';
                            } else {
                                optionsHtml = '<option value="" disabled selected class="text-danger">⚠️ Chưa có GV đăng ký dạy môn này</option>';
                            }
                            warningBadge = '<div class="text-danger small mt-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Chưa có GV đăng ký dạy môn này</div>';
                        }

                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="text-center text-muted">${idx + 1}</td>
                            <td class="fw-bold text-primary">${s.subjectCode}</td>
                            <td>
                                <div class="fw-semibold text-dark">${s.subjectName}</div>
                                <span class="badge bg-light text-muted border">${s.credits} Tín chỉ</span>
                            </td>
                            <td><code class="text-dark bg-light px-2 py-1 rounded border small">${s.code}</code></td>
                            <td class="small text-secondary">${scheds}</td>
                            <td>
                                <select class="form-select form-select-sm select-lecturer" data-section-id="${s.id}">
                                    ${optionsHtml}
                                </select>
                                ${warningBadge}
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });

                    document.getElementById('assignContent').style.display = 'block';
                } else {
                    document.getElementById('assignEmpty').style.display = 'block';
                }
            })
            .catch(err => {
                document.getElementById('assignLoading').style.display = 'none';
                document.getElementById('assignEmpty').style.display = 'block';
                document.getElementById('assignEmpty').innerText = 'Không thể tải dữ liệu phân bổ giáo viên: ' + err;
            });
    }

    function autoPickMatchingLecturers() {
        const selects = document.querySelectorAll('#assignTableBody select.select-lecturer');
        let pickIdx = 0;
        selects.forEach(sel => {
            const validOptions = Array.from(sel.options).filter(opt => opt.value && !opt.disabled);
            if (validOptions.length > 0) {
                const opt = validOptions[pickIdx % validOptions.length];
                sel.value = opt.value;
                pickIdx++;
            }
        });
    }

    function submitAssignLecturers(event) {
        event.preventDefault();
        const classId = parseInt(document.getElementById('assignClassId').value);
        const selects = document.querySelectorAll('#assignTableBody select.select-lecturer');

        const assignments = [];
        selects.forEach(sel => {
            const sectionId = parseInt(sel.dataset.sectionId);
            const lecturerId = sel.value ? parseInt(sel.value) : null;
            assignments.push({ courseSectionId: sectionId, lecturerId: lecturerId });
        });

        const btn = document.getElementById('btnSaveLecturers');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        fetch('/Classes/SaveLecturersAssignment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ classId: classId, assignments: assignments })
        })
        .then(res => res.json())
        .then(res => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu Phân bổ Giáo viên';
            if (res.success) {
                bootstrap.Modal.getInstance(document.getElementById('modalAssignLecturers'))?.hide();
                alert(res.message || 'Đã phân bổ giáo viên thành công!');
                window.location.reload();
            } else {
                alert('Lỗi: ' + (res.message || 'Không thể lưu phân bổ giáo viên.'));
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu Phân bổ Giáo viên';
            alert('Lỗi kết nối: ' + err);
        });
    }

    function autoAssignLecturersAll() {
        if (!confirm('Hệ thống sẽ tự động phân bổ giảng viên theo đúng chuyên môn khoa/ngành cho tất cả các môn của toàn bộ lớp hành chính trong hệ thống. Bạn có chắc chắn muốn thực hiện?')) {
            return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Classes/AutoAssignLecturers';
        document.body.appendChild(form);
        form.submit();
    }

    function openClassStudentsModal(classId, classCode, semester, majorCode, specCode, studentCount) {
        document.getElementById('studentsClassCodeBadge').innerText = classCode;
        const specInfo = specCode ? ` (Ngành hẹp: ${specCode})` : ' (Cơ sở ngành)';
        document.getElementById('studentsClassSubTitle').innerText = `Ngành: ${majorCode}${specInfo} | Kỳ học: ${semester}`;

        document.getElementById('studentsLoading').style.display = 'block';
        document.getElementById('studentsContent').style.display = 'none';
        document.getElementById('studentsEmpty').style.display = 'none';

        new bootstrap.Modal(document.getElementById('modalClassStudents')).show();

        fetch(`/Classes/GetStudents?id=${classId}`)
            .then(res => res.json())
            .then(res => {
                document.getElementById('studentsLoading').style.display = 'none';
                if (res.success && res.data && res.data.students && res.data.students.length > 0) {
                    const students = res.data.students;
                    document.getElementById('studentsCountBadge').innerText = students.length;
                    const tbody = document.getElementById('studentsTableBody');
                    tbody.innerHTML = '';
                    students.forEach((s, idx) => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="text-center text-muted">${idx + 1}</td>
                            <td class="fw-bold text-primary">${s.studentCode}</td>
                            <td class="fw-semibold text-dark">${s.fullName}</td>
                            <td><span class="text-muted small">${s.email}</span></td>
                            <td class="text-center"><span class="badge bg-light text-dark border">Kỳ ${s.currentSemester}</span></td>
                            <td class="text-center"><span class="badge bg-success-subtle text-success border border-success">Đang học</span></td>
                        `;
                        tbody.appendChild(tr);
                    });
                    document.getElementById('studentsContent').style.display = 'block';
                } else {
                    document.getElementById('studentsEmpty').style.display = 'block';
                }
            })
            .catch(err => {
                document.getElementById('studentsLoading').style.display = 'none';
                document.getElementById('studentsEmpty').style.display = 'block';
                document.getElementById('studentsEmpty').innerText = 'Không thể tải danh sách sinh viên: ' + err;
            });
    }

    // Tự động tính toán chuỗi OData URL xem trước cho Lớp hành chính
    function updateClassODataPreview() {
        const search = (document.getElementById('classFilterSearch').value || '').trim();
        const majorId = document.getElementById('classFilterMajor').value;
        const specId = document.getElementById('classFilterSpec').value;
        const currentSemester = document.getElementById('classFilterSemester').value;
        const orderby = document.getElementById('classFilterOrderBy').value;

        const filters = [];
        if (search) {
            filters.push(`(contains(tolower(Code), '${search.toLowerCase()}') or contains(tolower(Name), '${search.toLowerCase()}'))`);
        }
        if (majorId) {
            filters.push(`MajorId eq ${majorId}`);
        }
        if (specId) {
            filters.push(`SpecializationId eq ${specId}`);
        }
        if (currentSemester) {
            filters.push(`CurrentSemester eq ${currentSemester}`);
        }

        const queryParams = [];
        if (filters.length > 0) {
            queryParams.push(`$filter=${filters.join(' and ')}`);
        }
        if (orderby) {
            queryParams.push(`$orderby=${orderby}`);
        }

        const previewElem = document.getElementById('classODataPreview');
        if (previewElem) {
            previewElem.textContent = '/api/classes' + (queryParams.length > 0 ? '?' + queryParams.join('&') : '');
        }
    }

    function onClassFilterMajorChange() {
        const majorSelect = document.getElementById('classFilterMajor');
        const specSelect = document.getElementById('classFilterSpec');
        const majorId = majorSelect.value ? parseInt(majorSelect.value) : null;

        specSelect.innerHTML = '<option value="">-- Tất cả ngành hẹp --</option>';
        if (majorId) {
            const filtered = specializationsData.filter(s => s.majorId === majorId);
            filtered.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.id;
                opt.textContent = `${s.code} - ${s.name}`;
                specSelect.appendChild(opt);
            });
        }
        updateClassODataPreview();
    }

    // Khởi tạo danh sách ngành hẹp cho ngành đầu tiên khi tải trang
    document.addEventListener('DOMContentLoaded', function () {
        onAddClassMajorChange();
    });
</script>
}
