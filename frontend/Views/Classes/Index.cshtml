                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 45px;" class="text-center">#</th>
                                        <th style="width: 110px;">Mã môn</th>
                                        <th style="width: 230px;">Tên môn học</th>
                                        <th style="width: 140px;">Mã Lớp HP</th>
                                        <th style="width: 180px;">Lịch học dự kiến</th>
                                        <th>Giảng viên phụ trách <span class="text-danger">*</span></th>
                                    </tr>
