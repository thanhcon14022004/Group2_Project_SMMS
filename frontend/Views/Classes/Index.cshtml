@model List<project_PRN232.Frontend.Models.ClassViewModel>
@{
    ViewData["Title"] = "Quản lý Lớp Hành chính";
    var majors = (List<project_PRN232.Frontend.Models.MajorViewModel>)(ViewBag.Majors ?? new List<project_PRN232.Frontend.Models.MajorViewModel>());
    var semesters = (List<project_PRN232.Frontend.Models.SemesterViewModel>)(ViewBag.Semesters ?? new List<project_PRN232.Frontend.Models.SemesterViewModel>());
    var specializations = (List<project_PRN232.Frontend.Models.SpecializationViewModel>)(ViewBag.Specializations ?? new List<project_PRN232.Frontend.Models.SpecializationViewModel>());
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-chalkboard text-primary me-2"></i>Danh sách Lớp Hành chính
        </h5>
        <small class="text-muted">Quản lý lớp hành chính theo ngành, ngành hẹp (tùy chọn), kỳ học và học phần (mùa học)</small>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm text-dark fw-semibold" onclick="autoAssignLecturersAll()">
            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Tự động Phân bổ Giáo viên
        </button>
        <a asp-action="Allocations" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-users-gear me-1"></i> Phân bổ Sinh viên vào Lớp
        </a>
        <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddClass">
            <i class="fa-solid fa-plus me-1"></i> Thêm Lớp Mới
        </button>
    </div>
</div>

<!-- Thanh Bộ Lọc OData Nâng Cao -->
<div class="card shadow-sm border-0 rounded-3 mb-3 bg-white">
    <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                <i class="fa-solid fa-filter me-1"></i>Bộ Lọc OData
            </span>
            <small class="text-muted">Lọc lớp hành chính với cú pháp <code>$filter</code>, <code>$orderby</code> theo chuẩn OData v4</small>
        </div>
        <div>
            <span class="badge bg-light text-dark border">Tổng cộng @Model.Count lớp hành chính</span>
        </div>
    </div>
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="classODataForm">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" id="classFilterSearch" class="form-control" 
                               placeholder="Tìm mã hoặc tên lớp..." value="@ViewBag.CurrentSearch" oninput="updateClassODataPreview()" />
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="majorId" id="classFilterMajor" class="form-select form-select-sm" onchange="onClassFilterMajorChange()">
                        <option value="">-- Tất cả ngành --</option>
                        @foreach (var m in majors)
                        {
                            if (ViewBag.CurrentMajorId != null && (int)ViewBag.CurrentMajorId == m.Id)
                            {
                                <option value="@m.Id" data-code="@m.Code" selected>@m.Code - @m.Name</option>
                            }
                            else
                            {
                                <option value="@m.Id" data-code="@m.Code">@m.Code - @m.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="specializationId" id="classFilterSpec" class="form-select form-select-sm" onchange="updateClassODataPreview()">
                        <option value="">-- Tất cả ngành hẹp --</option>
                        @foreach (var sp in specializations)
                        {
                            if (ViewBag.CurrentSpecializationId != null && (int)ViewBag.CurrentSpecializationId == sp.Id)
                            {
                                <option value="@sp.Id" selected>@sp.Code - @sp.Name</option>
                            }
                            else
                            {
                                <option value="@sp.Id">@sp.Code - @sp.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="currentSemester" id="classFilterSemester" class="form-select form-select-sm" onchange="updateClassODataPreview()">
                        <option value="">-- Kì --</option>
                        @for (int sem = 1; sem <= 9; sem++)
                        {
                            if (ViewBag.CurrentSemesterNum != null && (int)ViewBag.CurrentSemesterNum == sem)
                            {
                                <option value="@sem" selected>Kì @sem</option>
                            }
                            else
                            {
                                <option value="@sem">Kì @sem</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="orderby" id="classFilterOrderBy" class="form-select form-select-sm" onchange="updateClassODataPreview()">
                        <option value="">-- Sắp xếp ($orderby) --</option>
                        <!option value="Code asc" @(ViewBag.CurrentOrderBy == "Code asc" ? "selected" : "")>Mã lớp A - Z</!option>
                        <!option value="Code desc" @(ViewBag.CurrentOrderBy == "Code desc" ? "selected" : "")>Mã lớp Z - A</!option>
                        <!option value="CurrentSemester asc" @(ViewBag.CurrentOrderBy == "CurrentSemester asc" ? "selected" : "")>Kì học tăng dần</!option>
                        <!option value="CurrentSemester desc" @(ViewBag.CurrentOrderBy == "CurrentSemester desc" ? "selected" : "")>Kì học giảm dần</!option>
                    </select>
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100 shadow-sm" title="Áp dụng bộ lọc OData lên Server">
                        <i class="fa-solid fa-play"></i> Lọc
                    </button>
                    @if (!string.IsNullOrEmpty((string)ViewBag.CurrentODataQuery))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- Preview OData Query String -->
            <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between flex-wrap gap-2 small text-muted">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary fw-semibold"><i class="fa-solid fa-code text-primary me-1"></i>OData Query URL:</span>
                    <code id="classODataPreview" class="text-primary bg-light px-2 py-1 rounded border">/api/classes@(string.IsNullOrEmpty((string)ViewBag.CurrentODataQuery) ? "" : "?" + ViewBag.CurrentODataQuery)</code>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success-subtle text-success border border-success">
                        <i class="fa-solid fa-check me-1"></i>OData v4 Supported
                    </span>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 120px;">Mã lớp</th>
                        <th>Ngành & Ngành hẹp</th>
                        <th style="width: 80px;">Kì</th>
                        <th>Học phần (Mùa học)</th>
                        <th>Môn học (CTĐT)</th>
                        <th>Tên lớp</th>
                        <th style="width: 100px;">Sĩ số</th>
                        <th class="text-center" style="width: 100px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 110px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-folder-open fa-2x mb-2 d-block text-secondary"></i>
                                Chưa có lớp hành chính nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@c.Code</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                            <i class="fa-solid fa-graduation-cap me-1"></i>@c.MajorCode
                                        </span>
                                        @if (!string.IsNullOrEmpty(c.SpecializationCode))
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info px-2 py-1" title="Chuyên ngành hẹp: @c.SpecializationCode">
                                                <i class="fa-solid fa-code-branch me-1"></i>Hẹp: @c.SpecializationCode
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        Kỳ @c.CurrentSemester
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                        <i class="fa-regular fa-calendar-check me-1"></i>@c.AcademicYear
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 fw-semibold"
                                            onclick="openClassSectionsModal(@c.Id, '@c.Code', @c.CurrentSemester, '@c.AcademicYear', '@c.MajorCode', '@(c.SpecializationCode ?? "")')"
                                            title="Xem danh sách các môn học được tạo tự động theo CTĐT">
                                        <i class="fa-solid fa-book-open me-1"></i>@c.CourseSectionsCount môn
                                    </button>
                                </td>
                                <td>
                                    <div class="fw-semibold">@c.Name</div>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 fw-semibold"
                                            onclick="openClassStudentsModal(@c.Id, '@c.Code', @c.CurrentSemester, '@c.MajorCode', '@(c.SpecializationCode ?? "")', @c.StudentCount)"
                                            title="Xem danh sách @c.StudentCount sinh viên thuộc lớp hành chính @c.Code">
                                        <i class="fa-solid fa-users me-1 text-primary"></i>@c.StudentCount SV
                                    </button>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(c.IsActive ? "bg-success" : "bg-danger") rounded-pill px-2">
                                        @(c.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-outline-success btn-sm rounded-pill me-1" onclick="openAssignLecturersModal(@c.Id, '@c.Code', '@c.MajorCode', @c.CurrentSemester, '@(c.SpecializationCode ?? "")')" title="Phân bổ giáo viên cho lớp @c.Code">
                                        <i class="fa-solid fa-chalkboard-user"></i>
                                    </button>
                                    <button class="btn btn-outline-primary btn-sm rounded-pill me-1" onclick="openClassStudentsModal(@c.Id, '@c.Code', @c.CurrentSemester, '@c.MajorCode', '@(c.SpecializationCode ?? "")', @c.StudentCount)" title="Xem danh sách sinh viên lớp @c.Code">
                                        <i class="fa-solid fa-users"></i>
                                    </button>
                                    <button class="btn btn-outline-warning btn-sm rounded-pill me-1" onclick="openEditClassModal(@c.Id, '@c.Code', '@Html.Raw(Html.Encode(c.Name))', '@c.AcademicYear', @c.CurrentSemester, @(c.SpecializationId?.ToString() ?? "null"), @(c.IsActive ? "true" : "false"))" title="Sửa lớp">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa lớp @c.Code? Nếu lớp đang có sinh viên, hệ thống sẽ chuyển sang Inactive.');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Xóa lớp">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Lớp Hành Chính (MÃ LỚP, NGÀNH, NGÀNH HẸP (TÙY CHỌN), KÌ, HỌC PHẦN) -->
<div class="modal fade" id="modalAddClass" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-controller="Classes" asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle me-2"></i>Thêm Lớp Hành Chính Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 small mb-3 border-0 bg-info-subtle text-info-emphasis rounded-3">
                        <i class="fa-solid fa-wand-magic-sparkles text-primary me-1"></i>Khi tạo lớp thành công, hệ thống sẽ <strong>tự động lấy Cấu hình CTĐT</strong> theo Ngành, Ngành hẹp (nếu có) và Kì học để tạo toàn bộ môn học cho lớp này.
                    </div>

                    <!-- Gợi ý nhanh mã lớp -->
                    <div class="d-flex flex-wrap align-items-center gap-1 mb-3">
                        <small class="text-muted fw-semibold me-1"><i class="fa-solid fa-wand-magic-sparkles text-warning me-1"></i>Mẫu nhanh:</small>
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill py-0 px-2" onclick="fillClassSample('SE1801', 1)">SE1801</button>
                        <button type="button" class="btn btn-xs btn-outline-success rounded-pill py-0 px-2" onclick="fillClassSample('AI1801', 1002)">AI1801</button>
                        <button type="button" class="btn btn-xs btn-outline-danger rounded-pill py-0 px-2" onclick="fillClassSample('MKT1801', 1012)">MKT1801</button>
                        <button type="button" class="btn btn-xs btn-outline-info rounded-pill py-0 px-2" onclick="fillClassSample('IB1801', 1013)">IB1801</button>
                    </div>

                    <!-- 1. Mã lớp -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">1. Mã lớp <span class="text-danger">*</span></label>
                        <input type="text" name="code" id="addClassCode" class="form-control" placeholder="VD: SE1801, AI1801, MKT1801..." required />
                        <div class="form-text small text-muted">Mã định danh lớp (ví dụ: SE1801, AI1801, MKT1801...).</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <!-- 2. Ngành -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">2. Ngành học <span class="text-danger">*</span></label>
                            <select name="majorId" id="addClassMajorId" class="form-select" onchange="onAddClassMajorChange()" required>
                                @foreach (var m in majors)
                                {
                                    <option value="@m.Id" data-code="@m.Code">@m.Code - @m.Name</option>
                                }
                            </select>
                        </div>

                        <!-- 3. Ngành hẹp (Không bắt buộc) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                3. Ngành hẹp <span class="badge bg-light text-secondary border ms-1">Tùy chọn</span>
                            </label>
                            <select name="specializationId" id="addClassSpecId" class="form-select">
                                <option value="">-- Không chọn (Cơ sở ngành) --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <!-- 4. Kì -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">4. Kì (Học kỳ hiện tại) <span class="text-danger">*</span></label>
                            <select name="currentSemester" class="form-select" required>
                                <option value="1">Kỳ 1</option>
                                <option value="2">Kỳ 2</option>
                                <option value="3" selected>Kỳ 3</option>
                                <option value="4">Kỳ 4</option>
                                <option value="5">Kỳ 5</option>
                                <option value="6">Kỳ 6 (OJT)</option>
                                <option value="7">Kỳ 7</option>
                                <option value="8">Kỳ 8</option>
                                <option value="9">Kỳ 9 (Đồ án)</option>
                            </select>
                        </div>

                        <!-- 5. Học phần (Mùa học) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">5. Học phần (Mùa học) <span class="text-danger">*</span></label>
                            <select name="academicYear" class="form-select" required>
                                @if (semesters != null && semesters.Any())
                                {
                                    foreach (var sem in semesters)
                                    {
                                        <option value="@sem.Code" selected="@(sem.Status == "Active")">
                                            @sem.Code (@sem.Name)
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="Summer 26" selected>Summer 26</option>
                                    <option value="Spring 26">Spring 26</option>
                                    <option value="Fall 26">Fall 26</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Lưu Lớp
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Lớp Hành Chính -->
<div class="modal fade" id="modalEditClass" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-controller="Classes" asp-action="Edit" method="post">
                <input type="hidden" name="id" id="editClassId" />
                <div class="modal-header bg-warning-subtle text-dark">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-pen-to-square text-warning me-2"></i>Chỉnh Sửa Lớp: <span id="editClassCodeBadge" class="text-primary"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên lớp <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editClassName" class="form-control" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Kỳ hiện tại (1 - 9)</label>
                            <select name="currentSemester" id="editClassSemester" class="form-select" required>
                                <option value="1">Kỳ 1</option>
                                <option value="2">Kỳ 2</option>
                                <option value="3">Kỳ 3</option>
                                <option value="4">Kỳ 4</option>
                                <option value="5">Kỳ 5</option>
                                <option value="6">Kỳ 6 (OJT)</option>
                                <option value="7">Kỳ 7</option>
                                <option value="8">Kỳ 8</option>
                                <option value="9">Kỳ 9 (Đồ án)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Học phần (Mùa học)</label>
                            <select name="academicYear" id="editClassAcademicYear" class="form-select" required>
                                @if (semesters != null && semesters.Any())
                                {
                                    foreach (var sem in semesters)
                                    {
                                        <option value="@sem.Code">@sem.Code (@sem.Name)</option>
                                    }
                                }
                                else
                                {
                                    <option value="Summer 26">Summer 26</option>
                                    <option value="Spring 26">Spring 26</option>
                                    <option value="Fall 26">Fall 26</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ngành hẹp (Tùy chọn)</label>
                        <select name="specializationId" id="editClassSpecId" class="form-select">
                            <option value="">-- Không chọn (Cơ sở ngành) --</option>
                            @foreach (var sp in specializations)
                            {
                                <option value="@sp.Id">@sp.Code - @sp.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editClassActive" value="true" />
                        <label class="form-check-label fw-semibold" for="editClassActive">Đang hoạt động (Active)</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Cập nhật Lớp
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem danh sách môn học của Lớp Hành Chính (Theo CTĐT) -->
<div class="modal fade" id="modalClassSections" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="fa-solid fa-graduation-cap me-2"></i>Môn Học Theo CTĐT - Lớp <span id="sectionsClassCodeBadge" class="badge bg-white text-primary"></span>
                    </h5>
                    <small id="sectionsClassSubTitle" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div id="sectionsLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Đang tải danh sách môn học theo CTĐT...</p>
                </div>
                <div id="sectionsContent" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-light text-dark border">
                            Tổng cộng: <strong id="sectionsCountBadge" class="text-primary">0</strong> môn học
                        </span>
                        <div class="d-flex gap-2">
