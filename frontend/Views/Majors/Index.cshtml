@model List<project_PRN232.Frontend.Models.MajorViewModel>
@{
    ViewData["Title"] = "Quản lý Ngành & Chuyên ngành hẹp";
    var defaultMajorId = ViewBag.SelectedMajorId != null 
        ? (int)ViewBag.SelectedMajorId 
        : 0; // Mặc định 0 là "all" (Xem tất cả), hoặc có thể chọn ngành đầu tiên
}

<!-- TIÊU ĐỀ TRANG & NÚT THÊM NGÀNH -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="fw-bold mb-0 text-dark">Danh sách Ngành Đào Tạo</h5>
        <small class="text-muted">Quản lý các ngành chính và chuyên ngành hẹp theo quy định</small>
    </div>
    <button class="btn btn-primary btn-sm rounded-3 shadow-sm px-3 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#modalAddMajor">
        <i class="fa-solid fa-plus me-1"></i> Thêm Ngành Mới
    </button>
</div>

<!-- KHỐI BỘ LỌC GỌN GÀNG VỚI 1 DROPDOWN FULL OPTION RA HẾT CÁC NGÀNH -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <!-- Cột 1: Nhãn bộ lọc -->
            <div class="col-lg-3 col-md-4 d-flex align-items-center gap-2">
                <div class="bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                    <i class="fa-solid fa-filter fa-lg"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark small text-uppercase">Bộ Lọc Ngành Đào Tạo</div>
                    <div class="text-muted small" style="font-size: 0.8rem;">Tổng số: <strong class="text-primary">@Model.Count</strong> ngành đào tạo</div>
                </div>
            </div>

            <!-- Cột 2: Dropdown 1 cái duy nhất có Full Option hiển thị ra tất cả các ngành -->
            <div class="col-lg-6 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-primary border-end-0 fw-semibold">
                        <i class="fa-solid fa-graduation-cap me-1"></i> Ngành:
                    </span>
                    <select class="form-select border-start-0 ps-2 fw-semibold text-dark shadow-none" id="majorSelectDropdown" onchange="selectMajor(this.value)">
                        <option value="all">
                            🌟 [Tất Cả Các Ngành] — Hiển thị toàn bộ (@Model.Count ngành)
                        </option>
                        <optgroup label="─── TÙY CHỌN TỪNG NGÀNH CỤ THỂ ───">
                            @foreach (var major in Model)
                            {
                                <option value="@major.Id">
                                    [@major.Code] @major.Name (@major.Specializations.Count chuyên ngành)
                                </option>
                            }
                        </optgroup>
                    </select>
                </div>
            </div>

            <!-- Cột 3: Nút chuyển chế độ nhanh (Xem tất cả / Từng ngành) -->
            <div class="col-lg-3 col-md-3 text-md-end">
                <div class="btn-group btn-group-sm w-100" role="group">
                    <button type="button" class="btn btn-outline-primary fw-semibold py-2" id="btnViewAll" onclick="selectMajor('all')" title="Hiển thị tất cả các ngành">
                        <i class="fa-solid fa-border-all me-1"></i> Tất cả
                    </button>
                    <button type="button" class="btn btn-outline-secondary fw-semibold py-2" id="btnViewSingle" onclick="selectMajor(@(Model.FirstOrDefault()?.Id ?? 1))" title="Xem chi tiết từng ngành">
                        <i class="fa-solid fa-square me-1"></i> 1 Ngành
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KHU VỰC HIỂN THỊ DANH SÁCH NGÀNH & CHUYÊN NGÀNH HẸP -->
<div class="row g-3" id="majorsContainer">
    @if (Model.Count == 0)
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3 text-center py-5">
                <div class="card-body">
                    <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
                    <h6 class="text-muted fw-bold">Chưa có ngành đào tạo nào trong hệ thống</h6>
                    <p class="text-muted small">Vui lòng bấm nút <strong>"+ Thêm Ngành Mới"</strong> ở góc trên bên phải để bắt đầu thiết lập.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var major in Model)
        {
            <div class="major-item-wrapper col-md-6" id="major-card-@major.Id" data-major-id="@major.Id">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <!-- HEADER CỦA NGÀNH (Giữ đầy đủ 100% nút: Ngành hẹp, Sửa, Xóa, Code badge) -->
                    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span class="badge @(major.IsActive ? "bg-primary" : "bg-secondary") fs-6 px-2 py-1 font-monospace">@major.Code</span>
                            <strong class="fs-6 text-dark">@major.Name</strong>
                            @if (!major.IsActive)
                            {
                                <span class="badge bg-danger ms-1">Inactive</span>
                            }
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-monospace" style="font-size: 0.72rem;">
                                @major.Specializations.Count chuyên ngành
                            </span>
                        </div>
                        <div class="d-flex gap-1 align-items-center">
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1" onclick="openAddSpecModal(@major.Id, '@major.Code')" title="Thêm ngành hẹp">
                                <i class="fa-solid fa-plus me-1"></i> Ngành hẹp
                            </button>
                            <button class="btn btn-outline-warning btn-sm rounded-pill px-2 py-1" onclick="openEditMajorModal(@major.Id, '@major.Code', '@major.Name', '@(major.Description ?? "")', @(major.IsActive ? "true" : "false"))" title="Sửa ngành">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa ngành @major.Code? Nếu ngành có liên kết lớp học, hệ thống sẽ chuyển sang trạng thái Inactive.');">
                                <input type="hidden" name="id" value="@major.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" title="Xóa ngành">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Mô tả ngành đào tạo -->
                        <p class="text-muted small mb-3">@(string.IsNullOrWhiteSpace(major.Description) ? "Chưa có mô tả cho ngành này." : major.Description)</p>
                        
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold small text-uppercase text-secondary mb-0">CÁC CHUYÊN NGÀNH HẸP:</h6>
                            <button class="btn btn-link btn-sm text-primary p-0 text-decoration-none fw-semibold" onclick="openAddSpecModal(@major.Id, '@major.Code')">
                                <i class="fa-solid fa-plus me-1"></i>Thêm nhanh
                            </button>
                        </div>

                        <!-- Danh sách chuyên ngành hẹp -->
                        @if (major.Specializations.Count == 0)
                        {
                            <div class="text-muted small fst-italic py-2">Chưa có chuyên ngành hẹp nào được cấu hình.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @foreach (var spec in major.Specializations)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                                        <div class="me-2">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-secondary-subtle text-secondary me-1 font-monospace">@spec.Code</span>
                                                <strong class="text-dark">@spec.Name</strong>
                                            </div>
                                            <div class="text-muted" style="font-size: 0.8rem;">@spec.Description</div>
                                        </div>
                                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                            <span class="badge @(spec.IsActive ? "bg-success" : "bg-danger")" style="font-size: 0.7rem;">
                                                @(spec.IsActive ? "Active" : "Inactive")
                                            </span>
                                            <button class="btn btn-link text-warning p-0 ms-1" onclick="openEditSpecModal(@spec.Id, '@spec.Code', '@spec.Name', '@(spec.Description ?? "")', @(spec.IsActive ? "true" : "false"), @major.Id)" title="Sửa ngành hẹp">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                            <form asp-action="DeleteSpecialization" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chuyên ngành @spec.Code?');">
                                                <input type="hidden" name="id" value="@spec.Id" />
                                                <input type="hidden" name="majorId" value="@major.Id" />
                                                <button type="submit" class="btn btn-link text-danger p-0 ms-1" title="Xóa ngành hẹp">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Modal Thêm Ngành -->
<div class="modal fade" id="modalAddMajor" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Majors" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thêm Ngành Đào Tạo Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã ngành (Code) <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control" placeholder="VD: SE, IA, AI..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên ngành <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="VD: Kỹ thuật phần mềm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô tả</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Nhập mô tả giới thiệu về ngành đào tạo..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu Ngành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Ngành -->
<div class="modal fade" id="modalEditMajor" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Majors" asp-action="Edit" method="post">
                <input type="hidden" name="id" id="editMajorId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Chỉnh Sửa Ngành: <span id="editMajorCodeBadge" class="text-primary font-monospace"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên ngành <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editMajorName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô tả</label>
                        <textarea name="description" id="editMajorDesc" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editMajorActive" value="true" />
                        <label class="form-check-label fw-semibold" for="editMajorActive">Trạng thái Hoạt động (Active)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="fa-solid fa-floppy-disk me-1"></i> Cập nhật Ngành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Thêm Ngành Hẹp -->
<div class="modal fade" id="modalAddSpec" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Majors" asp-action="CreateSpecialization" method="post">
                <input type="hidden" name="majorId" id="specMajorId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thêm Chuyên Ngành Hẹp (<span id="specMajorCode" class="text-primary font-monospace"></span>)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã chuyên ngành hẹp <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control" placeholder="VD: SE-IS, IA-NW..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên chuyên ngành hẹp <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="VD: Hệ thống thông tin doanh nghiệp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô tả</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Nhập mô tả chuyên ngành hẹp..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu Chuyên Ngành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Ngành Hẹp -->
<div class="modal fade" id="modalEditSpec" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Majors" asp-action="EditSpecialization" method="post">
                <input type="hidden" name="id" id="editSpecId" />
                <input type="hidden" name="majorId" id="editSpecMajorId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Chỉnh Sửa Chuyên Ngành: <span id="editSpecCodeBadge" class="text-primary font-monospace"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên chuyên ngành <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editSpecName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô tả</label>
                        <textarea name="description" id="editSpecDesc" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editSpecActive" value="true" />
                        <label class="form-check-label fw-semibold" for="editSpecActive">Trạng thái Hoạt động (Active)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold"><i class="fa-solid fa-floppy-disk me-1"></i> Cập nhật Chuyên Ngành</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Hàm chọn ngành theo giá trị dropdown (hỗ trợ cả 'all' hoặc majorId cụ thể)
    function selectMajor(target) {
        const dropdown = document.getElementById('majorSelectDropdown');
        const btnViewAll = document.getElementById('btnViewAll');
        const btnViewSingle = document.getElementById('btnViewSingle');
        const items = document.querySelectorAll('.major-item-wrapper');

        if (target === 'all' || target === 0 || target === '0') {
            // Chế độ: XEM TẤT CẢ CÁC NGÀNH
            items.forEach(item => {
                item.classList.remove('d-none');
                item.classList.remove('col-12');
                item.classList.add('col-md-6');
            });
            if (dropdown) dropdown.value = 'all';
            if (btnViewAll) {
                btnViewAll.className = 'btn btn-primary active fw-semibold py-2 text-white';
            }
            if (btnViewSingle) {
                btnViewSingle.className = 'btn btn-outline-secondary fw-semibold py-2';
            }
            try {
                sessionStorage.setItem('smms_active_major_id', 'all');
                window.location.hash = 'all';
            } catch (e) { }
        } else {
            // Chế độ: XEM DUY NHẤT 1 NGÀNH ĐƯỢC CHỌN (Full width, thoáng mắt)
            const majorId = parseInt(target);
            items.forEach(item => {
                const itemId = parseInt(item.getAttribute('data-major-id'));
                if (itemId === majorId) {
                    item.classList.remove('d-none');
                    item.classList.remove('col-md-6');
                    item.classList.add('col-12');
                } else {
                    item.classList.add('d-none');
                }
            });
            if (dropdown) dropdown.value = majorId.toString();
            if (btnViewAll) {
                btnViewAll.className = 'btn btn-outline-primary fw-semibold py-2';
            }
            if (btnViewSingle) {
                btnViewSingle.className = 'btn btn-primary active fw-semibold py-2 text-white';
            }
            try {
                sessionStorage.setItem('smms_active_major_id', majorId);
                window.location.hash = 'major-' + majorId;
            } catch (e) { }
        }
    }

    // Modal Handlers
    function openAddSpecModal(majorId, majorCode) {
        document.getElementById('specMajorId').value = majorId;
        document.getElementById('specMajorCode').innerText = majorCode;
        new bootstrap.Modal(document.getElementById('modalAddSpec')).show();
    }

    function openEditMajorModal(id, code, name, desc, isActive) {
        document.getElementById('editMajorId').value = id;
        document.getElementById('editMajorCodeBadge').innerText = code;
        document.getElementById('editMajorName').value = name;
        document.getElementById('editMajorDesc').value = desc;
        document.getElementById('editMajorActive').checked = isActive;
        new bootstrap.Modal(document.getElementById('modalEditMajor')).show();
    }

    function openEditSpecModal(id, code, name, desc, isActive, majorId) {
        document.getElementById('editSpecId').value = id;
        document.getElementById('editSpecCodeBadge').innerText = code;
        document.getElementById('editSpecName').value = name;
        document.getElementById('editSpecDesc').value = desc;
        document.getElementById('editSpecActive').checked = isActive;
        if (majorId) {
            document.getElementById('editSpecMajorId').value = majorId;
        }
        new bootstrap.Modal(document.getElementById('modalEditSpec')).show();
    }

    // Khởi tạo trạng thái khi trang vừa load
    document.addEventListener("DOMContentLoaded", function () {
        let initialTarget = 'all'; // Mặc định mở Tất cả các ngành hoặc giữ lại lựa chọn trước

        @if (defaultMajorId > 0)
        {
            <text>initialTarget = @defaultMajorId;</text>
        }
        else
        {
            <text>
            const hash = window.location.hash;
            if (hash && hash.startsWith('#major-')) {
                const parsed = parseInt(hash.replace('#major-', ''));
                if (!isNaN(parsed) && document.getElementById('major-card-' + parsed)) {
                    initialTarget = parsed;
                }
            } else if (hash === '#all') {
                initialTarget = 'all';
            } else {
                const saved = sessionStorage.getItem('smms_active_major_id');
                if (saved === 'all') {
                    initialTarget = 'all';
                } else if (saved) {
                    const parsedSaved = parseInt(saved);
                    if (!isNaN(parsedSaved) && document.getElementById('major-card-' + parsedSaved)) {
                        initialTarget = parsedSaved;
                    }
                }
            }
            </text>
        }

        selectMajor(initialTarget);
    });
</script>
}
