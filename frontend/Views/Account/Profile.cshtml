@model project_PRN232.Frontend.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var roleBadge = Model.Role == "Admin" ? "bg-danger" : Model.Role == "Lecturer" ? "bg-primary" : "bg-success";
    var roleName = Model.Role == "Admin" ? "Quản trị viên" : Model.Role == "Lecturer" ? "Giảng viên" : "Sinh viên";
}

<!-- Banner Hero Hồ Sơ Cá Nhân -->
<div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative">
                    <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 72px; height: 72px; font-size: 28px; font-weight: 700; min-width: 72px;">
                        @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U")
                    </div>
                    <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-2 border-white rounded-circle" title="Tài khoản đang hoạt động"></span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge @roleBadge fw-bold px-3 py-1 rounded-pill shadow-sm">
                            <i class="fa-solid fa-shield-halved me-1"></i>@roleName
                        </span>
                        <span class="badge bg-white bg-opacity-25 text-white fw-bold px-3 py-1 rounded-pill font-monospace">
                            @@@Model.Username
                        </span>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.FullName</h3>
                    <div class="small text-white-50 d-flex flex-wrap align-items-center gap-3">
                        <span><i class="fa-solid fa-envelope me-1"></i>@Model.Email</span>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <span>|</span>
                            <span><i class="fa-solid fa-phone me-1"></i>@Model.PhoneNumber</span>
                        }
                        <span>|</span>
                        <span><i class="fa-solid fa-calendar-check me-1"></i>Tham gia: @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/Dashboard" class="btn btn-outline-light btn-sm fw-semibold px-3 py-2 rounded-3">
                    <i class="fa-solid fa-house me-1"></i>Về Trang Chủ
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thẻ tóm tắt thông tin tài khoản & Bảo mật -->
    <div class="col-lg-4 d-flex flex-column gap-4">
        <!-- Thẻ chi tiết tài khoản -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="card-title mb-0 fw-bold text-dark">
                    <i class="fa-solid fa-id-card text-primary me-2"></i>Thông Tin Tổng Quan
                </h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                        <span class="text-muted"><i class="fa-solid fa-user me-2"></i>Tên tài khoản:</span>
                        <span class="fw-bold font-monospace bg-light px-2 py-1 rounded border">@Model.Username</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                        <span class="text-muted"><i class="fa-solid fa-user-tag me-2"></i>Vai trò hệ thống:</span>
                        <span class="badge @roleBadge rounded-pill px-3 py-1">@roleName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                        <span class="text-muted"><i class="fa-solid fa-circle-check me-2"></i>Trạng thái:</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                            <i class="fa-solid fa-check me-1"></i>Đang hoạt động
                        </span>
                    </li>

                    @if (Model.Role == "Admin")
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                            <span class="text-muted"><i class="fa-solid fa-shield-virus me-2"></i>Cấp độ:</span>
                            <span class="fw-semibold text-danger">Super Administrator</span>
                        </li>
                        <li class="list-group-item py-3 px-3">
                            <span class="text-muted d-block mb-1"><i class="fa-solid fa-key me-2"></i>Quyền hạn quản trị:</span>
                            <div class="text-dark fw-semibold small bg-light p-2 rounded border">
                                Toàn quyền điều hành SMMS: Sinh viên, Giảng viên, Lớp học phần, Sổ điểm & Người dùng.
                            </div>
                        </li>
                    }
                    else if (Model.Role == "Lecturer")
                    {
                        @if (!string.IsNullOrEmpty(Model.LecturerCode))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="text-muted"><i class="fa-solid fa-barcode me-2"></i>Mã giảng viên:</span>
                                <span class="fw-bold text-primary font-monospace">@Model.LecturerCode</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.AcademicTitle))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="text-muted"><i class="fa-solid fa-graduation-cap me-2"></i>Học hàm / Học vị:</span>
                                <span class="fw-semibold text-dark">@Model.AcademicTitle</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.Department))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="text-muted"><i class="fa-solid fa-building me-2"></i>Bộ môn:</span>
                                <span class="fw-semibold text-dark">@Model.Department</span>
                            </li>
                        }
                    }
                    else if (Model.Role == "Student")
                    {
                        @if (!string.IsNullOrEmpty(Model.StudentCode))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="text-muted"><i class="fa-solid fa-id-badge me-2"></i>Mã sinh viên:</span>
                                <span class="fw-bold text-success font-monospace">@Model.StudentCode</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.MajorName))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="text-muted"><i class="fa-solid fa-network-wired me-2"></i>Ngành đào tạo:</span>
                                <span class="fw-semibold text-dark text-end">@Model.MajorName</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.AdministrativeClassName))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="text-muted"><i class="fa-solid fa-chalkboard me-2"></i>Lớp hành chính:</span>
                                <span class="badge bg-secondary-subtle text-dark border">@Model.AdministrativeClassName</span>
                            </li>
                        }
                    }

                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                        <span class="text-muted"><i class="fa-solid fa-clock-rotate-left me-2"></i>Đăng nhập lần cuối:</span>
                        <span class="text-dark">@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Phiên hiện tại")</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Thẻ Lưu ý an toàn tài khoản -->
        <div class="card shadow-sm border-0 rounded-3 bg-light">
            <div class="card-body p-3">
                <div class="d-flex align-items-start gap-2">
                    <i class="fa-solid fa-shield-halved text-success fa-xl mt-1"></i>
                    <div>
                        <div class="fw-bold text-dark small mb-1">An toàn & Bảo mật tài khoản:</div>
                        <ul class="text-muted small ps-3 mb-0" style="font-size: 0.82rem; line-height: 1.5;">
                            <li>Nên đổi mật khẩu định kỳ 3 - 6 tháng một lần.</li>
                            <li>Mật khẩu nên chứa tối thiểu 6 ký tự, kết hợp chữ in hoa, chữ số và ký tự đặc biệt.</li>
                            <li>Không chia sẻ tài khoản cho người khác để đảm bảo tính toàn vẹn dữ liệu điểm số.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Form chỉnh sửa thông tin & Đổi mật khẩu -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0 fw-bold text-dark">
                    <i class="fa-solid fa-user-pen text-primary me-2"></i>Chỉnh Sửa Hồ Sơ Cá Nhân
                </h6>
                <span class="badge bg-primary-subtle text-primary">Cập nhật thông tin</span>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Profile" method="post" id="profileForm">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="Username" value="@Model.Username" />
                    <input type="hidden" name="Role" value="@Model.Role" />

                    <!-- PHẦN 1: THÔNG TIN CƠ BẢN -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary mb-3 pb-2 border-bottom d-flex align-items-center">
                            <i class="fa-solid fa-circle-user me-2"></i>1. Thông Tin Cơ Bản
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-user"></i></span>
                                    <input type="text" class="form-control border-start-0 ps-0" name="FullName" value="@Model.FullName" required placeholder="Nhập đầy đủ họ và tên..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Tên đăng nhập (Username)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-lock"></i></span>
                                    <input type="text" class="form-control border-start-0 ps-0 bg-light" value="@Model.Username" disabled readonly />
                                </div>
                                <div class="form-text small text-muted">Tên đăng nhập được quản lý bởi Quản trị viên hệ thống.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-envelope"></i></span>
                                    <input type="email" class="form-control border-start-0 ps-0" name="Email" value="@Model.Email" required placeholder="name@smms.edu.vn" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Số điện thoại liên hệ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-phone"></i></span>
                                    <input type="tel" class="form-control border-start-0 ps-0" name="PhoneNumber" value="@Model.PhoneNumber" placeholder="Ví dụ: 0912345678" />
                                </div>
                            </div>

                            @if (Model.Role == "Lecturer")
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Học hàm / Học vị</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-graduation-cap"></i></span>
                                        <select class="form-select border-start-0 ps-0" name="AcademicTitle">
                                            <option value="Thạc sĩ" selected="@(Model.AcademicTitle == "Thạc sĩ" || Model.AcademicTitle == "Master")">Thạc sĩ (Master)</option>
                                            <option value="Tiến sĩ" selected="@(Model.AcademicTitle == "Tiến sĩ" || Model.AcademicTitle == "PhD")">Tiến sĩ (PhD)</option>
                                            <option value="Phó Giáo sư" selected="@(Model.AcademicTitle == "Phó Giáo sư" || Model.AcademicTitle == "Associate Professor")">Phó Giáo sư (Assoc. Prof)</option>
                                            <option value="Giáo sư" selected="@(Model.AcademicTitle == "Giáo sư" || Model.AcademicTitle == "Professor")">Giáo sư (Professor)</option>
                                            <option value="Cử nhân / Kỹ sư" selected="@(Model.AcademicTitle == "Cử nhân" || Model.AcademicTitle == "Bachelor")">Cử nhân / Kỹ sư (Bachelor)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Bộ môn phụ trách</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-building"></i></span>
                                        <input type="text" class="form-control border-start-0 ps-0" name="Department" value="@Model.Department" placeholder="Ví dụ: Kỹ thuật phần mềm" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- PHẦN 2: ĐỔI MẬT KHẨU -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between pb-2 border-bottom mb-3">
                            <h6 class="fw-bold text-primary mb-0 d-flex align-items-center">
                                <i class="fa-solid fa-key text-warning me-2"></i>2. Bảo Mật & Đổi Mật Khẩu
                            </h6>
                            <span class="badge bg-warning-subtle text-dark small">Tùy chọn</span>
                        </div>
                        <div class="alert alert-light border small text-muted mb-3 d-flex align-items-center py-2 px-3">
                            <i class="fa-solid fa-circle-info text-info me-2 fa-lg"></i>
                            <div>Chỉ điền vào các ô dưới đây nếu bạn muốn thay đổi mật khẩu đăng nhập. Nếu giữ nguyên mật khẩu cũ, vui lòng để trống.</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-semibold">Mật khẩu hiện tại</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-lock"></i></span>
                                    <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="currentPassword" name="CurrentPassword" placeholder="Nhập mật khẩu hiện tại nếu muốn đổi..." autocomplete="current-password" />
                                    <button class="btn btn-outline-secondary border-start-0 toggle-password-btn" type="button" data-target="currentPassword">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Mật khẩu mới</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-key"></i></span>
                                    <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="newPassword" name="NewPassword" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary border-start-0 toggle-password-btn" type="button" data-target="newPassword">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Xác nhận mật khẩu mới</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-secondary border-end-0"><i class="fa-solid fa-check-double"></i></span>
                                    <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="confirmPassword" name="ConfirmPassword" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary border-start-0 toggle-password-btn" type="button" data-target="confirmPassword">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NÚT THAO TÁC -->
                    <div class="pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="small text-muted">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i>Hệ thống sẽ cập nhật ngay sau khi lưu.
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/Dashboard" class="btn btn-outline-secondary px-3 py-2 rounded-3">
                                <i class="fa-solid fa-arrow-left me-1"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4 py-2 rounded-3 shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Lưu Thay Đổi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Toggle ẩn/hiện mật khẩu
        document.querySelectorAll(".toggle-password-btn").forEach(function (button) {
            button.addEventListener("click", function () {
                const targetId = this.getAttribute("data-target");
                const input = document.getElementById(targetId);
                const icon = this.querySelector("i");

                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            });
        });

        // Kiểm tra khớp mật khẩu trước khi submit nếu người dùng có nhập mật khẩu mới
        const form = document.getElementById("profileForm");
        form?.addEventListener("submit", function (e) {
            const currentPass = document.getElementById("currentPassword").value;
            const newPass = document.getElementById("newPassword").value;
            const confirmPass = document.getElementById("confirmPassword").value;

            if (newPass.length > 0) {
                if (currentPass.length === 0) {
                    e.preventDefault();
                    alert("Vui lòng nhập mật khẩu hiện tại để đổi mật khẩu!");
                    document.getElementById("currentPassword").focus();
                    return false;
                }
                if (newPass.length < 6) {
                    e.preventDefault();
                    alert("Mật khẩu mới phải có tối thiểu 6 ký tự!");
                    document.getElementById("newPassword").focus();
                    return false;
                }
                if (newPass !== confirmPass) {
                    e.preventDefault();
                    alert("Mật khẩu mới và mật khẩu xác nhận không khớp nhau!");
                    document.getElementById("confirmPassword").focus();
                    return false;
                }
            }
        });
    });
</script>
}
