@model project_PRN232.Frontend.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Hệ thống";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light py-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 460px; width: 100%;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="fa-solid fa-graduation-cap fa-2x"></i>
                </div>
                <h3 class="fw-bold text-primary">SMMS</h3>
                <p class="text-muted small">Hệ thống Quản lý Điểm Sinh viên (PRN232 .NET Project)</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @Model.ErrorMessage
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                        <input type="text" class="form-control" asp-for="Username" required placeholder="Tên đăng nhập...">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" class="form-control" asp-for="Password" required placeholder="Mật khẩu...">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Đăng nhập hệ thống
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <p class="text-muted small mb-2 fw-semibold">Đăng nhập nhanh thử nghiệm (1-Click):</p>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                        <input type="hidden" name="username" value="admin" />
                        <input type="hidden" name="password" value="Admin@123" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fa-solid fa-shield me-1"></i> Admin
                        </button>
                    </form>
                    <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                        <input type="hidden" name="username" value="gv_hungnv" />
                        <input type="hidden" name="password" value="Admin@123" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-chalkboard-user me-1"></i> Giảng viên
                        </button>
                    </form>
                    <form asp-controller="Account" asp-action="QuickLogin" method="post" class="d-inline">
                        <input type="hidden" name="username" value="he170001" />
                        <input type="hidden" name="password" value="Admin@123" />
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            <i class="fa-solid fa-user-graduate me-1"></i> Sinh viên
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

