@model project_PRN232.Frontend.Models.PagedResult<project_PRN232.Frontend.Models.UserItemViewModel>
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Quản lý Người dùng & Tài khoản";
    var currentUsername = HttpContextAccessor.HttpContext?.Session.GetString("SMMS_USER_USERNAME") ?? "";
    var currentUserIdStr = HttpContextAccessor.HttpContext?.Session.GetString("SMMS_USER_ID") ?? "";
    int.TryParse(currentUserIdStr, out var currentUserId);

    var majors = ViewBag.Majors as List<project_PRN232.Frontend.Models.MajorViewModel> ?? new();
    var classes = ViewBag.Classes as List<project_PRN232.Frontend.Models.ClassViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-users-gear text-primary me-2"></i>Quản lý Tài khoản Người dùng</h5>
        <small class="text-muted">Quản trị danh sách tài khoản Admin, Giảng viên và Sinh viên toàn hệ thống SMMS</small>
    </div>
    <button class="btn btn-primary btn-sm rounded-3 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalAddUser">
        <i class="fa-solid fa-user-plus me-1"></i> Thêm Tài khoản Mới
    </button>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Users" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-secondary">Tìm kiếm theo tên / mã</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" class="form-control form-control-sm border-start-0" placeholder="Tên đăng nhập, họ tên, email..." value="@Context.Request.Query["search"]" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Vai trò (Role)</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="Admin" selected="@(Context.Request.Query["role"] == "Admin" ? "selected" : null)">Admin (Quản trị viên)</option>
                    <option value="Lecturer" selected="@(Context.Request.Query["role"] == "Lecturer" ? "selected" : null)">Lecturer (Giảng viên)</option>
                    <option value="Student" selected="@(Context.Request.Query["role"] == "Student" ? "selected" : null)">Student (Sinh viên)</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm rounded-3 flex-grow-1 fw-semibold shadow-sm">
                    <i class="fa-solid fa-filter me-1"></i> Lọc dữ liệu
                </button>
                @if (!string.IsNullOrEmpty(Context.Request.Query["search"]) || !string.IsNullOrEmpty(Context.Request.Query["role"]))
                {
                    <a asp-action="Users" class="btn btn-outline-secondary btn-sm rounded-3 px-3" title="Đặt lại bộ lọc">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 45px;" class="text-center">#</th>
                        <th style="min-width: 140px;">Tài khoản & Mã</th>
                        <th style="min-width: 180px;">Họ và tên</th>
                        <th style="min-width: 220px;">Hồ sơ & Đào tạo</th>
                        <th style="min-width: 180px;">Liên hệ (Email/SĐT)</th>
                        <th style="width: 110px;" class="text-center">Vai trò</th>
                        <th style="width: 110px;" class="text-center">Trạng thái</th>
                        <th style="width: 150px;" class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fa-2x mb-2 text-muted"></i>
                                <div>Không tìm thấy tài khoản người dùng nào phù hợp.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var u in Model.Items)
                        {
                            bool isSelf = (string.Equals(u.Username, currentUsername, StringComparison.OrdinalIgnoreCase)) || (currentUserId > 0 && u.Id == currentUserId);

                            <tr class="@(isSelf ? "table-primary bg-primary-subtle bg-opacity-25" : "")">
                                <td class="text-center text-muted fw-semibold">@u.Id</td>
                                <td>
                                    <div class="fw-bold font-monospace text-primary">@u.Username</div>
                                    @if (u.Role == "Student" && !string.IsNullOrWhiteSpace(u.StudentCode))
                                    {
                                        <span class="badge bg-light text-primary border font-monospace mt-1" style="font-size: 0.75rem;">
                                            MSSV: @u.StudentCode
                                        </span>
                                    }
                                    else if (u.Role == "Lecturer" && !string.IsNullOrWhiteSpace(u.LecturerCode))
                                    {
                                        <span class="badge bg-light text-success border font-monospace mt-1" style="font-size: 0.75rem;">
                                            Mã GV: @u.LecturerCode
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        @u.FullName
                                        @if (isSelf)
                                        {
                                            <span class="badge bg-primary text-white ms-1 shadow-sm rounded-pill" style="font-size: 0.72rem;">
                                                <i class="fa-solid fa-circle-user me-1"></i>Bạn (Đang đăng nhập)
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted">Tham gia: @u.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @if (u.Role == "Student")
                                    {
                                        <div><i class="fa-solid fa-chalkboard me-1 text-primary"></i>Lớp: <strong>@(u.AdministrativeClassName ?? "Chưa xếp lớp")</strong></div>
                                        <small class="text-muted"><i class="fa-solid fa-graduation-cap me-1"></i>Ngành: @(u.MajorName ?? "Chưa xác định")</small>
                                    }
                                    else if (u.Role == "Lecturer")
                                    {
                                        <div><i class="fa-solid fa-building me-1 text-secondary"></i>@(u.Department ?? "Software Engineering") <span class="badge bg-info-subtle text-info border">@(u.AcademicTitle ?? "Master")</span></div>
                                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0 mt-1" 
                                                onclick="openLecturerSubjectsModal(@(u.LecturerId ?? 0), @u.Id, '@u.FullName', '@u.Username')"
                                                title="Quản lý danh sách môn đăng ký giảng dạy">
                                            <i class="fa-solid fa-book-open-reader me-1"></i>Môn dạy
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">
                                            <i class="fa-solid fa-shield-halved me-1"></i>Quản trị toàn quyền
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-truncate" style="max-width: 220px;" title="@u.Email">
                                        <i class="fa-regular fa-envelope me-1 text-muted"></i>@u.Email
                                    </div>
                                    <div class="small text-muted">
                                        <i class="fa-solid fa-phone me-1"></i>@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Admin</span>
                                    }
                                    else if (u.Role == "Lecturer")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info px-2 py-1">Lecturer</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Student</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">
                                            <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <!-- Nút Sửa: Luôn khả dụng để cập nhật thông tin -->
                                    <button class="btn btn-outline-warning btn-sm rounded-3 me-1" onclick="openEditUserModal(@u.Id, '@u.Username', '@u.FullName', '@u.Email', '@(u.PhoneNumber ?? "")')" title="Sửa thông tin tài khoản">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <!-- Nút Khóa / Mở khóa: BẢO VỆ CHÍNH MÌNH (Disabled nếu là current user) -->
                                    @if (isSelf)
                                    {
                                        <button type="button" class="btn btn-light btn-sm rounded-3 me-1 border text-muted" disabled title="Tài khoản hiện tại của bạn (Không thể tự khóa)">
                                            <i class="fa-solid fa-user-shield text-primary"></i>
                                        </button>
                                        <button type="button" class="btn btn-light btn-sm rounded-3 border text-muted" disabled title="Tài khoản hiện tại của bạn (Không thể tự xóa)">
                                            <i class="fa-solid fa-ban text-muted"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                            @if (u.IsActive)
                                            {
                                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-3 me-1" title="Khóa tài khoản" onclick="return confirm('Bạn có chắc muốn khóa tài khoản @u.Username?')">
                                                    <i class="fa-solid fa-user-lock"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success btn-sm rounded-3 me-1" title="Kích hoạt tài khoản">
                                                    <i class="fa-solid fa-user-check"></i>
                                                </button>
                                            }
                                        </form>

                                        <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản @u.Username? Nếu tài khoản đã có dữ liệu liên kết, hệ thống sẽ chuyển sang Inactive.');">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3" title="Xóa tài khoản">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang (Pagination) -->
        @if (Model != null && Model.TotalPages > 0)
        {
            var curRole = Context.Request.Query["role"].ToString();
            var curSearch = Context.Request.Query["search"].ToString();
            var startItem = (Model.PageIndex - 1) * Model.PageSize + 1;
            var endItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);

            <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="text-muted small">
                    Hiển thị <strong>@startItem</strong> - <strong>@endItem</strong> trong tổng số <strong>@Model.TotalCount</strong> người dùng
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- Dropdown chọn số dòng/trang -->
                    <div class="d-flex align-items-center gap-1 me-2">
                        <span class="small text-muted">Hiển thị:</span>
                        <select class="form-select form-select-sm" style="width: 75px;" onchange="changePageSize(this.value)">
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                        </select>
                    </div>

                    <!-- Nút phân trang -->
                    <nav aria-label="Users pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- Nút Đầu -->
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Users" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-role="@curRole" asp-route-search="@curSearch" title="Trang đầu">
                                    <i class="fa-solid fa-angles-left"></i>
                                </a>
                            </li>
                            <!-- Nút Trước -->
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Users" asp-route-page="@(Model.PageIndex - 1)" asp-route-pageSize="@Model.PageSize" asp-route-role="@curRole" asp-route-search="@curSearch" title="Trang trước">
                                    <i class="fa-solid fa-angle-left"></i>
                                </a>
                            </li>

                            <!-- Các trang số lân cận -->
                            @{
                                var startPage = Math.Max(1, Model.PageIndex - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                            }
                            @for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link fw-semibold" asp-action="Users" asp-route-page="@p" asp-route-pageSize="@Model.PageSize" asp-route-role="@curRole" asp-route-search="@curSearch">
                                        @p
                                    </a>
                                </li>
                            }

                            <!-- Nút Sau -->
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Users" asp-route-page="@(Model.PageIndex + 1)" asp-route-pageSize="@Model.PageSize" asp-route-role="@curRole" asp-route-search="@curSearch" title="Trang sau">
                                    <i class="fa-solid fa-angle-right"></i>
                                </a>
                            </li>
                            <!-- Nút Cuối -->
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Users" asp-route-page="@Model.TotalPages" asp-route-pageSize="@Model.PageSize" asp-route-role="@curRole" asp-route-search="@curSearch" title="Trang cuối">
                                    <i class="fa-solid fa-angles-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Thêm Tài Khoản Mới (Hỗ trợ nhập đủ trường theo vai trò) -->
<div class="modal fade" id="modalAddUser" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CreateUser" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2"></i>Thêm Tài Khoản Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input type="text" name="username" class="form-control" placeholder="VD: minhtq17, gv_hungnv..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" class="form-control" placeholder="VD: Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vai trò phân quyền (Role) <span class="text-danger">*</span></label>
                            <select name="role" id="newUserRoleSelect" class="form-select fw-semibold text-primary" onchange="toggleRoleSpecificFields(this.value)" required>
                                <option value="Student" selected>Student (Sinh viên)</option>
                                <option value="Lecturer">Lecturer (Giảng viên)</option>
                                <option value="Admin">Admin (Quản trị hệ thống)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email liên hệ <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" placeholder="a@fpt.edu.vn" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="text" name="phoneNumber" class="form-control" placeholder="09xxxxxxxx" />
                        </div>
                    </div>

                    <!-- Trường đặc thù dành cho SINH VIÊN -->
                    <div id="studentFieldsCard" class="card border border-primary border-opacity-25 bg-light p-3 mb-3">
                        <h6 class="fw-bold text-primary mb-3 small"><i class="fa-solid fa-graduation-cap me-1"></i>Thông tin hồ sơ Sinh viên</h6>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Mã sinh viên (MSSV)</label>
                                <input type="text" name="code" class="form-control form-control-sm" placeholder="VD: HE170001 (để trống tự sinh)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Ngành đào tạo</label>
                                <select name="majorId" class="form-select form-select-sm">
                                    @foreach (var m in majors)
                                    {
                                        <option value="@m.Id">@m.Code - @m.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Lớp hành chính</label>
                                <select name="administrativeClassId" class="form-select form-select-sm">
                                    <option value="">-- Chưa xếp lớp --</option>
                                    @foreach (var c in classes)
                                    {
                                        <option value="@c.Id">@c.Code (@c.Name)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Trường đặc thù dành cho GIẢNG VIÊN -->
                    <div id="lecturerFieldsCard" class="card border border-success border-opacity-25 bg-light p-3 mb-3" style="display: none;">
                        <h6 class="fw-bold text-success mb-3 small"><i class="fa-solid fa-chalkboard-user me-1"></i>Thông tin hồ sơ Giảng viên</h6>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Mã giảng viên</label>
                                <input type="text" name="code" class="form-control form-control-sm" placeholder="VD: GV001 (để trống tự sinh)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Học vị / Học hàm</label>
                                <select name="academicTitle" class="form-select form-select-sm">
                                    <option value="ThS" selected>Thạc sĩ (ThS)</option>
                                    <option value="TS">Tiến sĩ (TS)</option>
                                    <option value="PGS.TS">Phó Giáo sư (PGS.TS)</option>
                                    <option value="GS.TS">Giáo sư (GS.TS)</option>
                                    <option value="Cử nhân">Cử nhân / Kỹ sư</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Bộ môn phụ trách</label>
                                <input type="text" name="department" class="form-control form-control-sm" value="Software Engineering" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="fa-solid fa-check me-1"></i>Tạo Tài Khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Thông Tin Tài Khoản -->
<div class="modal fade" id="modalEditUser" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditUser" method="post">
                <input type="hidden" name="id" id="editUserId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Chỉnh Sửa Tài Khoản: <span id="editUserUsernameBadge" class="text-primary"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" id="editUserFullName" class="form-control" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" id="editUserEmail" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="text" name="phoneNumber" id="editUserPhone" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Đặt lại mật khẩu mới (để trống nếu không đổi)</label>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu mới nếu muốn đổi..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Cập nhật Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Quản lý Môn Dạy của Giảng Viên -->
<div class="modal fade" id="modalLecturerSubjects" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="fa-solid fa-graduation-cap me-2"></i>Quản lý Môn Giảng Dạy - Giảng viên: <span id="lsLecturerName" class="badge bg-white text-primary fs-6"></span>
                    </h5>
                    <small id="lsLecturerSubtitle" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Thanh công cụ -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-semibold text-secondary">
                        <i class="fa-solid fa-list-check me-1"></i>Danh sách các môn học giảng viên đã đăng ký giảng dạy:
                    </span>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" onclick="openAddSubjectForm()">
                        <i class="fa-solid fa-plus me-1"></i>Thêm môn dạy
                    </button>
                </div>

                <!-- Form Thêm / Cập nhật môn dạy (Ẩn mặc định) -->
                <div id="formSubjectContainer" class="card border border-primary border-opacity-25 bg-light mb-4 shadow-sm" style="display: none;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <h6 class="fw-bold text-primary mb-0" id="formSubjectTitle">
                                <i class="fa-solid fa-layer-group me-1"></i>Đăng ký Môn Dạy Mới
                            </h6>
                            <button type="button" class="btn-close btn-sm" onclick="closeSubjectForm()"></button>
                        </div>
                        <form id="formLecturerSubject" onsubmit="submitLecturerSubject(event)">
                            <input type="hidden" id="subRegId" value="0" />
                            <input type="hidden" id="subRegLecturerId" value="0" />

                            <div class="row g-2 mb-3 align-items-end">
                                <!-- 1. Chọn Ngành -->
                                <div class="col-md-5">
                                    <label class="form-label small fw-semibold">1. Chọn Ngành đào tạo <span class="text-danger">*</span></label>
                                    <select id="subRegMajor" class="form-select form-select-sm" onchange="onMajorChange()" required>
                                        <option value="">-- Chọn Ngành --</option>
                                    </select>
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label small fw-semibold">Ghi chú chung (tùy chọn)</label>
                                    <input type="text" id="subRegNotes" class="form-control form-control-sm" placeholder="VD: Giảng dạy các lớp K17, K18..." />
                                </div>
                            </div>

                            <!-- Khu vực hiển thị danh sách các môn học liên quan đến ngành đã chọn -->
                            <div id="subjectsListSection" class="border rounded-3 p-3 bg-white mb-3" style="display: none;">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom">
                                    <!-- Ô tìm kiếm môn học đầu danh sách -->
                                    <div class="input-group input-group-sm" style="max-width: 320px;">
                                        <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                                        <input type="text" id="subSearchInput" class="form-control border-start-0" placeholder="Tìm kiếm môn học theo mã hoặc tên..." oninput="filterSubjectsDisplay()" />
                                    </div>
                                    <!-- Nút chọn nhanh & badge số lượng đã chọn -->
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill py-1 px-2" onclick="selectAllSubjects(true)">
                                            <i class="fa-solid fa-check-double me-1"></i>Chọn tất cả
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-1 px-2" onclick="selectAllSubjects(false)">
                                            <i class="fa-solid fa-xmark me-1"></i>Bỏ chọn
                                        </button>
                                        <span class="badge bg-primary rounded-pill px-3 py-2">
                                            Đã chọn: <strong id="selectedCountBadge">0</strong> môn
                                        </span>
                                    </div>
                                </div>

                                <!-- Bảng danh sách môn học có scroll -->
                                <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th style="width: 45px;" class="text-center">
                                                    <input type="checkbox" id="chkSelectAllHeader" class="form-check-input" onchange="selectAllSubjects(this.checked)" title="Chọn/Bỏ chọn tất cả" />
                                                </th>
                                                <th style="width: 120px;">Mã môn</th>
                                                <th>Tên môn học</th>
                                                <th style="width: 80px;" class="text-center">Số TC</th>
                                                <th style="width: 160px;">Chuyên ngành hẹp</th>
                                                <th style="width: 140px;" class="text-center">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody id="batchSubjectsTableBody">
                                            <tr>
                                                <td colspan="6" class="text-center py-3 text-muted">Vui lòng chọn Ngành đào tạo ở trên.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" onclick="closeSubjectForm()">Hủy</button>
                                <button type="submit" id="btnSaveSubject" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="fa-solid fa-floppy-disk me-1"></i>Lưu môn dạy
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div id="lsLoading" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Đang tải danh sách môn học...</p>
                </div>

                <!-- Bảng danh sách môn đã đăng ký -->
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0" id="tableLecturerSubjects">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="width: 120px;">Mã môn</th>
                                <th>Tên môn học</th>
                                <th style="width: 80px;" class="text-center">Số TC</th>
                                <th style="width: 150px;">Ngành</th>
                                <th style="width: 200px;">Ngành hẹp</th>
                                <th style="width: 140px;" class="text-center">Ngày đăng ký</th>
                                <th style="width: 130px;" class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="lsTableBody">
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Chưa có môn học nào được đăng ký.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    @{
        var jsonCamelOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    }
    const allMajors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Majors as List<MajorViewModel>) ?? new List<MajorViewModel>(), jsonCamelOpts));
    const allSpecializations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Specializations as List<SpecializationViewModel>) ?? new List<SpecializationViewModel>(), jsonCamelOpts));
    const allSubjects = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Subjects as List<SubjectViewModel>) ?? new List<SubjectViewModel>(), jsonCamelOpts));

    // Helper an toàn đọc thuộc tính bất kể camelCase hay PascalCase
    function getVal(obj, ...keys) {
        if (!obj) return '';
        for (const k of keys) {
            if (obj[k] !== undefined && obj[k] !== null) return obj[k];
        }
        return '';
    }

    let currentLecturerId = 0;
    let currentUserId = 0;
    let registeredSubjectsList = [];
    let selectedSubjectIds = new Set();
    let currentMajorSubjects = [];

    function changePageSize(size) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', size);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }

    function toggleRoleSpecificFields(role) {
        const studentCard = document.getElementById('studentFieldsCard');
        const lecturerCard = document.getElementById('lecturerFieldsCard');
        if (!studentCard || !lecturerCard) return;

        if (role === 'Student') {
            studentCard.style.display = 'block';
            lecturerCard.style.display = 'none';
        } else if (role === 'Lecturer') {
            studentCard.style.display = 'none';
            lecturerCard.style.display = 'block';
        } else {
            studentCard.style.display = 'none';
            lecturerCard.style.display = 'none';
        }
    }

    function openEditUserModal(id, username, fullName, email, phone) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserUsernameBadge').innerText = username;
        document.getElementById('editUserFullName').value = fullName;
        document.getElementById('editUserEmail').value = email;
        document.getElementById('editUserPhone').value = phone;
        new bootstrap.Modal(document.getElementById('modalEditUser')).show();
    }

    function openLecturerSubjectsModal(lecturerId, userId, fullName, username) {
        currentLecturerId = lecturerId;
        currentUserId = userId;
        document.getElementById('lsLecturerName').innerText = fullName;
        document.getElementById('lsLecturerSubtitle').innerText = `Tài khoản: ${username} | Mã định danh: GV#${lecturerId > 0 ? lecturerId : userId}`;
        document.getElementById('subRegLecturerId').value = lecturerId > 0 ? lecturerId : userId;

        closeSubjectForm();
        loadLecturerSubjects();
        new bootstrap.Modal(document.getElementById('modalLecturerSubjects')).show();
    }

    function loadLecturerSubjects() {
        const loading = document.getElementById('lsLoading');
        const tbody = document.getElementById('lsTableBody');
        loading.style.display = 'block';
        tbody.innerHTML = '';

        const targetId = currentLecturerId > 0 ? currentLecturerId : currentUserId;
        fetch(`/Operations/GetLecturerSubjects?lecturerId=${targetId}`)
            .then(res => res.json())
            .then(res => {
                loading.style.display = 'none';
                if (res.success && res.data && res.data.length > 0) {
                    registeredSubjectsList = res.data;
                    renderLecturerSubjectsTable(res.data);
                } else {
                    registeredSubjectsList = [];
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Giảng viên này hiện chưa đăng ký môn giảng dạy nào. Vui lòng bấm <strong>"Thêm môn dạy"</strong> để bắt đầu.</td></tr>';
                }
            })
            .catch(err => {
                loading.style.display = 'none';
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger">Lỗi khi tải danh sách môn: ${err}</td></tr>`;
            });
    }

    function renderLecturerSubjectsTable(items) {
        const tbody = document.getElementById('lsTableBody');
        tbody.innerHTML = '';

        items.forEach((item, index) => {
            const tr = document.createElement('tr');
            const dateStr = item.registeredAt ? new Date(item.registeredAt).toLocaleDateString('vi-VN') : '-';

            const subCode = getVal(item, 'subjectCode', 'SubjectCode');
            const subName = getVal(item, 'subjectName', 'SubjectName');
            const subCredits = getVal(item, 'credits', 'Credits', 0);
            const notes = getVal(item, 'notes', 'Notes');
            const majorCode = getVal(item, 'majorCode', 'MajorCode') || getVal(item, 'majorName', 'MajorName');
            const specCode = getVal(item, 'specializationCode', 'SpecializationCode');
            const specName = getVal(item, 'specializationName', 'SpecializationName');
            const majorId = getVal(item, 'majorId', 'MajorId', 0);
            const specId = getVal(item, 'specializationId', 'SpecializationId', 0);
            const subjectId = getVal(item, 'subjectId', 'SubjectId', 0);
            const regId = getVal(item, 'id', 'Id', 0);

            const specDisplay = specName 
                ? `<span class="badge bg-info-subtle text-info border border-info">${specCode || ''}</span> <small class="text-dark">${specName}</small>` 
                : '<span class="text-muted small">Cơ sở ngành</span>';

            tr.innerHTML = `
                <td class="text-center text-muted">${index + 1}</td>
                <td class="fw-bold text-primary">${subCode}</td>
                <td>
                    <div class="fw-semibold text-dark">${subName}</div>
                    ${notes ? `<small class="text-muted fst-italic">${notes}</small>` : ''}
                </td>
                <td class="text-center"><span class="badge bg-light text-dark border">${subCredits}</span></td>
                <td><span class="badge bg-secondary-subtle text-secondary border border-secondary">${majorCode || '-'}</span></td>
                <td>${specDisplay}</td>
                <td class="text-center small text-muted">${dateStr}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-warning btn-sm rounded-3 me-1" 
                            onclick="openEditSubjectForm(${regId}, ${majorId}, ${specId}, ${subjectId}, '${notes.replace(/'/g, "\\'")}')"
                            title="Sửa môn đăng ký">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3" 
                            onclick="deleteLecturerSubject(${regId}, '${subCode}')"
                            title="Xóa môn đăng ký">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function openAddSubjectForm() {
        document.getElementById('formSubjectTitle').innerHTML = '<i class="fa-solid fa-layer-group me-1"></i>Đăng ký Môn Dạy Mới (Chọn nhiều môn)';
        document.getElementById('subRegId').value = '0';
        document.getElementById('subRegNotes').value = '';
        selectedSubjectIds.clear();
        currentMajorSubjects = [];
        document.getElementById('subjectsListSection').style.display = 'none';
        initMajorDropdown();
        updateSelectedCount();
        document.getElementById('formSubjectContainer').style.display = 'block';
    }

    function openEditSubjectForm(id, majorId, specId, subjectId, notes) {
        // Chế độ sửa: mở form và chọn ngành tương ứng
        document.getElementById('formSubjectTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-1"></i>Cập nhật Môn Đăng Ký';
        document.getElementById('subRegId').value = id;
        document.getElementById('subRegNotes').value = notes || '';

        initMajorDropdown(majorId);
        selectedSubjectIds.clear();
        if (subjectId) selectedSubjectIds.add(subjectId);

        if (majorId) {
            onMajorChange(subjectId);
        }

        document.getElementById('formSubjectContainer').style.display = 'block';
    }

    function closeSubjectForm() {
        document.getElementById('formSubjectContainer').style.display = 'none';
        document.getElementById('formLecturerSubject').reset();
        document.getElementById('subRegId').value = '0';
        selectedSubjectIds.clear();
        currentMajorSubjects = [];
        updateSelectedCount();
    }

    function initMajorDropdown(selectedMajorId = 0) {
        const majorSelect = document.getElementById('subRegMajor');
        majorSelect.innerHTML = '<option value="">-- Chọn Ngành đào tạo --</option>';

        allMajors.forEach(m => {
            const mId = getVal(m, 'id', 'Id');
            const mCode = getVal(m, 'code', 'Code');
            const mName = getVal(m, 'name', 'Name');
            const opt = document.createElement('option');
            opt.value = mId;
            opt.textContent = `${mCode} - ${mName}`;
            if (parseInt(mId) === parseInt(selectedMajorId)) opt.selected = true;
            majorSelect.appendChild(opt);
        });
    }

    function onMajorChange(preSelectedSubjectId = 0) {
        const majorId = parseInt(document.getElementById('subRegMajor').value) || 0;
        const listSection = document.getElementById('subjectsListSection');

        if (!majorId) {
            listSection.style.display = 'none';
            currentMajorSubjects = [];
            selectedSubjectIds.clear();
            updateSelectedCount();
            return;
        }

        const major = allMajors.find(m => parseInt(getVal(m, 'id', 'Id')) === majorId);
        const majorCode = major ? (getVal(major, 'code', 'Code') || '').toUpperCase() : '';

        // Danh sách specialization thuộc majorId này
        const specIdsOfMajor = new Set(
            allSpecializations
                .filter(sp => parseInt(getVal(sp, 'majorId', 'MajorId')) === majorId)
                .map(sp => parseInt(getVal(sp, 'id', 'Id')))
        );

        // Lọc môn học liên quan đến ngành này
        currentMajorSubjects = allSubjects.filter(s => {
            const sMajorId = parseInt(getVal(s, 'majorId', 'MajorId')) || 0;
            const sSpecId = parseInt(getVal(s, 'specializationId', 'SpecializationId')) || 0;

            if (sMajorId === majorId) return true;
            if (sSpecId && specIdsOfMajor.has(sSpecId)) return true;
            return false;
        });

        // Fallback dự phòng theo tiền tố mã môn học
        if (currentMajorSubjects.length === 0 && majorCode) {
            currentMajorSubjects = allSubjects.filter(s => {
                const code = (getVal(s, 'code', 'Code') || '').toUpperCase();
                if (['SE', 'IT'].includes(majorCode)) {
                    return code.startsWith('PR') || code.startsWith('SW') || code.startsWith('CS') || code.startsWith('DB') || code.startsWith('MA');
                }
                return code.startsWith(majorCode);
            });
        }

        if (preSelectedSubjectId > 0) {
            selectedSubjectIds.add(preSelectedSubjectId);
        }

        document.getElementById('subSearchInput').value = '';
        listSection.style.display = 'block';
        filterSubjectsDisplay();
    }

    function filterSubjectsDisplay() {
        const kw = (document.getElementById('subSearchInput')?.value || '').trim().toLowerCase();
        const tbody = document.getElementById('batchSubjectsTableBody');
        tbody.innerHTML = '';

        if (!currentMajorSubjects || currentMajorSubjects.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Ngành này hiện chưa có môn học nào được gán trong hệ thống.</td></tr>';
            return;
        }

        const filtered = currentMajorSubjects.filter(s => {
            if (!kw) return true;
            const code = (getVal(s, 'code', 'Code') || '').toLowerCase();
            const name = (getVal(s, 'name', 'Name') || '').toLowerCase();
            return code.includes(kw) || name.includes(kw);
        });

        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted">Không tìm thấy môn học nào khớp với từ khóa "<strong>' + kw + '</strong>".</td></tr>';
            return;
        }

        const registeredSubIds = new Set(registeredSubjectsList.map(item => parseInt(getVal(item, 'subjectId', 'SubjectId'))));

        filtered.forEach((s, idx) => {
            const sId = parseInt(getVal(s, 'id', 'Id'));
            const sCode = getVal(s, 'code', 'Code');
            const sName = getVal(s, 'name', 'Name');
            const sCredits = getVal(s, 'credits', 'Credits', 3);
            const specName = getVal(s, 'specializationName', 'SpecializationName') || getVal(s, 'specializationCode', 'SpecializationCode');

            const isRegistered = registeredSubIds.has(sId);
            const isChecked = selectedSubjectIds.has(sId);

            const tr = document.createElement('tr');
            if (isRegistered) {
                tr.classList.add('table-light', 'text-muted');
            }

            let checkHtml = '';
            let statusHtml = '';

            if (isRegistered) {
                checkHtml = `<input type="checkbox" class="form-check-input" checked disabled title="Giảng viên đã đăng ký môn này" />`;
                statusHtml = `<span class="badge bg-success-subtle text-success border border-success"><i class="fa-solid fa-check me-1"></i>Đã đăng ký</span>`;
            } else {
                checkHtml = `<input type="checkbox" class="form-check-input sub-chk" data-sub-id="${sId}" ${isChecked ? 'checked' : ''} onchange="onSubjectCheckChange(${sId}, this.checked)" />`;
                statusHtml = `<span class="badge bg-light text-secondary border">Chưa đăng ký</span>`;
            }

            tr.innerHTML = `
                <td class="text-center">${checkHtml}</td>
                <td class="fw-bold text-primary">${sCode}</td>
                <td><div class="fw-semibold text-dark">${sName}</div></td>
                <td class="text-center"><span class="badge bg-light text-dark border">${sCredits}</span></td>
                <td><small class="text-secondary">${specName || 'Cơ sở ngành'}</small></td>
                <td class="text-center">${statusHtml}</td>
            `;

            // Click vào hàng để toggle checkbox nếu chưa đăng ký
            if (!isRegistered) {
                tr.style.cursor = 'pointer';
                tr.addEventListener('click', (e) => {
                    if (e.target.tagName !== 'INPUT') {
                        const chk = tr.querySelector('.sub-chk');
                        if (chk) {
                            chk.checked = !chk.checked;
                            onSubjectCheckChange(sId, chk.checked);
                        }
                    }
                });
            }

            tbody.appendChild(tr);
        });

        updateSelectedCount();
    }

    function onSubjectCheckChange(subId, isChecked) {
        if (isChecked) {
            selectedSubjectIds.add(subId);
        } else {
            selectedSubjectIds.delete(subId);
        }
        updateSelectedCount();
    }

    function selectAllSubjects(checkAll) {
        const checkboxes = document.querySelectorAll('#batchSubjectsTableBody input.sub-chk');
        checkboxes.forEach(chk => {
            chk.checked = checkAll;
            const subId = parseInt(chk.dataset.subId);
            if (subId) {
                if (checkAll) selectedSubjectIds.add(subId);
                else selectedSubjectIds.delete(subId);
            }
        });
        const chkHeader = document.getElementById('chkSelectAllHeader');
        if (chkHeader) chkHeader.checked = checkAll;
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const badge = document.getElementById('selectedCountBadge');
        if (badge) badge.innerText = selectedSubjectIds.size;

        const btn = document.getElementById('btnSaveSubject');
        if (btn) {
            btn.innerHTML = selectedSubjectIds.size > 0 
                ? `<i class="fa-solid fa-floppy-disk me-1"></i>Lưu môn dạy (${selectedSubjectIds.size} môn)` 
                : `<i class="fa-solid fa-floppy-disk me-1"></i>Lưu môn dạy`;
        }
    }

    function submitLecturerSubject(event) {
        event.preventDefault();

        const majorId = parseInt(document.getElementById('subRegMajor').value) || 0;
        const id = parseInt(document.getElementById('subRegId').value) || 0;
        const notes = document.getElementById('subRegNotes').value.trim();
        const targetLecturerId = currentLecturerId > 0 ? currentLecturerId : currentUserId;

        if (!majorId) {
            alert('Vui lòng chọn Ngành đào tạo!');
            return;
        }

        const subjectIds = Array.from(selectedSubjectIds);
        if (subjectIds.length === 0) {
            alert('Vui lòng tick chọn ít nhất một môn học trong danh sách để đăng ký!');
            return;
        }

        const btn = document.getElementById('btnSaveSubject');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        fetch('/Operations/AddBatchLecturerSubjects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                lecturerId: targetLecturerId,
                majorId: majorId,
                subjectIds: subjectIds,
                notes: notes
            })
        })
        .then(res => res.json())
        .then(res => {
            btn.disabled = false;
            updateSelectedCount();
            if (res.success) {
                alert(res.message || `Đã đăng ký thành công ${subjectIds.length} môn học!`);
                closeSubjectForm();
                loadLecturerSubjects();
            } else {
                alert('Lỗi: ' + (res.message || 'Không thể lưu môn đăng ký.'));
            }
        })
        .catch(err => {
            btn.disabled = false;
            updateSelectedCount();
            alert('Lỗi kết nối: ' + err);
        });
    }

    function deleteLecturerSubject(subjectRegId, subjectCode) {
        if (!confirm(`Bạn có chắc chắn muốn xóa môn '${subjectCode}' khỏi danh sách đăng ký của giảng viên này?`)) {
            return;
        }

        const targetLecturerId = currentLecturerId > 0 ? currentLecturerId : currentUserId;
        fetch(`/Operations/DeleteLecturerSubject?lecturerId=${targetLecturerId}&subjectRegId=${subjectRegId}`, {
            method: 'POST'
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                alert(res.message || 'Đã xóa môn đăng ký thành công!');
                loadLecturerSubjects();
            } else {
                alert('Không thể xóa: ' + (res.message || 'Môn học đang có ràng buộc dữ liệu.'));
            }
        })
        .catch(err => {
            alert('Lỗi kết nối khi xóa: ' + err);
        });
    }
</script>
}
