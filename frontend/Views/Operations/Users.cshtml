@model List<project_PRN232.Frontend.Models.UserItemViewModel>
@{
    ViewData["Title"] = "Quản lý Người dùng & Tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0">Quản lý Tài khoản Người dùng</h5>
        <small class="text-muted">Quản lý tài khoản Admin, Giảng viên và Sinh viên trong toàn hệ thống</small>
    </div>
    <button class="btn btn-primary btn-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalAddUser">
        <i class="fa-solid fa-user-plus me-1"></i> Thêm Tài khoản Mới
    </button>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Users" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Tìm kiếm</label>
                <input type="text" name="search" class="form-control" placeholder="Tên đăng nhập, họ tên..." value="@Context.Request.Query["search"]" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Vai trò (Role)</label>
                <select name="role" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="Admin" selected="@(Context.Request.Query["role"] == "Admin" ? "selected" : null)">Admin</option>
                    <option value="Lecturer" selected="@(Context.Request.Query["role"] == "Lecturer" ? "selected" : null)">Lecturer (Giảng viên)</option>
                    <option value="Student" selected="@(Context.Request.Query["role"] == "Student" ? "selected" : null)">Student (Sinh viên)</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th>Tài khoản</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-center" style="width: 140px;">Môn dạy</th>
                        <th class="text-end" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Không tìm thấy tài khoản nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var u in Model)
                        {
                            <tr>
                                <td class="text-muted">@u.Id</td>
                                <td class="fw-bold">@u.Username</td>
                                <td>@u.FullName</td>
                                <td>@u.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)</td>
                                <td>
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">Admin</span>
                                    }
                                    else if (u.Role == "Lecturer")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning">Lecturer</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary">Student</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (u.Role == "Lecturer")
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" 
                                                onclick="openLecturerSubjectsModal(@(u.LecturerId ?? 0), @u.Id, '@u.FullName', '@u.Username')"
                                                title="Quản lý môn giảng viên đăng ký dạy">
                                            <i class="fa-solid fa-book-open-reader me-1"></i>Chi tiết
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-warning btn-sm rounded-3 me-1" onclick="openEditUserModal(@u.Id, '@u.Username', '@u.FullName', '@u.Email', '@(u.PhoneNumber ?? "")')" title="Sửa thông tin">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                        @if (u.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-3 me-1" title="Khóa tài khoản" onclick="return confirm('Bạn có chắc muốn khóa tài khoản @u.Username?')">
                                                <i class="fa-solid fa-user-lock"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-3 me-1" title="Kích hoạt tài khoản">
                                                <i class="fa-solid fa-user-check"></i>
                                            </button>
                                        }
                                    </form>
                                    <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản @u.Username? Nếu tài khoản có dữ liệu liên kết, hệ thống sẽ chuyển sang Inactive.');">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3" title="Xóa tài khoản">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Tài Khoản Mới -->
<div class="modal fade" id="modalAddUser" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus text-primary me-2"></i>Thêm Tài Khoản Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input type="text" name="username" class="form-control" placeholder="VD: lecturer03" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" placeholder="VD: Nguyễn Văn A" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" placeholder="a@fpt.edu.vn" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="text" name="phoneNumber" class="form-control" placeholder="09xxxxxxxx" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Vai trò phân quyền (Role) <span class="text-danger">*</span></label>
                        <select name="role" class="form-select" required>
                            <option value="Admin">Admin (Quản trị hệ thống)</option>
                            <option value="Lecturer" selected>Lecturer (Giảng viên)</option>
                            <option value="Student">Student (Sinh viên)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Tạo Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Thông Tin Tài Khoản -->
<div class="modal fade" id="modalEditUser" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditUser" method="post">
                <input type="hidden" name="id" id="editUserId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Chỉnh Sửa Tài Khoản: <span id="editUserUsernameBadge" class="text-primary"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên đầy đủ <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" id="editUserFullName" class="form-control" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" id="editUserEmail" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="text" name="phoneNumber" id="editUserPhone" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Đặt lại mật khẩu mới (để trống nếu không đổi)</label>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu mới nếu muốn đổi..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Cập nhật Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Quản lý Môn Dạy của Giảng Viên -->
<div class="modal fade" id="modalLecturerSubjects" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="fa-solid fa-graduation-cap me-2"></i>Quản lý Môn Giảng Dạy - Giảng viên: <span id="lsLecturerName" class="badge bg-white text-primary fs-6"></span>
                    </h5>
                    <small id="lsLecturerSubtitle" class="text-white-50"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Thanh công cụ -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-semibold text-secondary">
                        <i class="fa-solid fa-list-check me-1"></i>Danh sách các môn học giảng viên đã đăng ký giảng dạy:
                    </span>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" onclick="openAddSubjectForm()">
                        <i class="fa-solid fa-plus me-1"></i>Thêm môn dạy
                    </button>
                </div>

                <!-- Form Thêm / Cập nhật môn dạy (Ẩn mặc định) -->
                <div id="formSubjectContainer" class="card border border-primary border-opacity-25 bg-light mb-4 shadow-sm" style="display: none;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <h6 class="fw-bold text-primary mb-0" id="formSubjectTitle">
                                <i class="fa-solid fa-book-bookmark me-1"></i>Đăng ký Môn Dạy Mới
                            </h6>
                            <button type="button" class="btn-close btn-sm" onclick="closeSubjectForm()"></button>
                        </div>
                        <form id="formLecturerSubject" onsubmit="submitLecturerSubject(event)">
                            <input type="hidden" id="subRegId" value="0" />
                            <input type="hidden" id="subRegLecturerId" value="0" />

                            <div class="row g-2 mb-3">
                                <!-- 1. Chọn Ngành -->
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">1. Chọn Ngành <span class="text-danger">*</span></label>
                                    <select id="subRegMajor" class="form-select form-select-sm" onchange="onMajorChange()" required>
                                        <option value="">-- Chọn Ngành --</option>
                                    </select>
                                </div>
                                <!-- 2. Chọn Ngành hẹp -->
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">2. Chọn Ngành hẹp <span class="text-danger">*</span></label>
                                    <select id="subRegSpecialization" class="form-select form-select-sm" onchange="onSpecializationChange()" disabled required>
                                        <option value="">-- Vui lòng chọn Ngành trước --</option>
                                    </select>
                                </div>
                                <!-- 3. Chọn Môn học -->
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">3. Chọn Môn học <span class="text-danger">*</span></label>
                                    <select id="subRegSubject" class="form-select form-select-sm" disabled required>
                                        <option value="">-- Vui lòng chọn Ngành hẹp trước --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Ghi chú (tùy chọn)</label>
                                    <input type="text" id="subRegNotes" class="form-control form-control-sm" placeholder="VD: Giảng dạy các lớp K17, K18..." />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" onclick="closeSubjectForm()">Hủy</button>
                                <button type="submit" id="btnSaveSubject" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="fa-solid fa-floppy-disk me-1"></i>Lưu môn dạy
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div id="lsLoading" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Đang tải danh sách môn học...</p>
                </div>

                <!-- Bảng danh sách môn đã đăng ký -->
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0" id="tableLecturerSubjects">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="width: 120px;">Mã môn</th>
                                <th>Tên môn học</th>
                                <th style="width: 80px;" class="text-center">Số TC</th>
                                <th style="width: 150px;">Ngành</th>
                                <th style="width: 200px;">Ngành hẹp</th>
                                <th style="width: 140px;" class="text-center">Ngày đăng ký</th>
                                <th style="width: 130px;" class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="lsTableBody">
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Chưa có môn học nào được đăng ký.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    @{
        var jsonCamelOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    }
    const allMajors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Majors as List<MajorViewModel>) ?? new List<MajorViewModel>(), jsonCamelOpts));
    const allSpecializations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Specializations as List<SpecializationViewModel>) ?? new List<SpecializationViewModel>(), jsonCamelOpts));
    const allSubjects = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Subjects as List<SubjectViewModel>) ?? new List<SubjectViewModel>(), jsonCamelOpts));

    // Helper an toàn đọc thuộc tính bất kể camelCase hay PascalCase
    function getVal(obj, ...keys) {
        if (!obj) return '';
        for (const k of keys) {
            if (obj[k] !== undefined && obj[k] !== null) return obj[k];
        }
        return '';
    }

    let currentLecturerId = 0;
    let currentUserId = 0;
    let registeredSubjectsList = [];

    function openEditUserModal(id, username, fullName, email, phone) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserUsernameBadge').innerText = username;
        document.getElementById('editUserFullName').value = fullName;
        document.getElementById('editUserEmail').value = email;
        document.getElementById('editUserPhone').value = phone;
        new bootstrap.Modal(document.getElementById('modalEditUser')).show();
    }

    function openLecturerSubjectsModal(lecturerId, userId, fullName, username) {
        currentLecturerId = lecturerId;
        currentUserId = userId;
        document.getElementById('lsLecturerName').innerText = fullName;
        document.getElementById('lsLecturerSubtitle').innerText = `Tài khoản: ${username} | Mã định danh: GV#${lecturerId > 0 ? lecturerId : userId}`;
        document.getElementById('subRegLecturerId').value = lecturerId > 0 ? lecturerId : userId;

        closeSubjectForm();
        loadLecturerSubjects();
        new bootstrap.Modal(document.getElementById('modalLecturerSubjects')).show();
    }

    function loadLecturerSubjects() {
        const loading = document.getElementById('lsLoading');
        const tbody = document.getElementById('lsTableBody');
        loading.style.display = 'block';
        tbody.innerHTML = '';

        const targetId = currentLecturerId > 0 ? currentLecturerId : currentUserId;
        fetch(`/Operations/GetLecturerSubjects?lecturerId=${targetId}`)
            .then(res => res.json())
            .then(res => {
                loading.style.display = 'none';
                if (res.success && res.data && res.data.length > 0) {
                    registeredSubjectsList = res.data;
                    renderLecturerSubjectsTable(res.data);
                } else {
                    registeredSubjectsList = [];
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Giảng viên này hiện chưa đăng ký môn giảng dạy nào. Vui lòng bấm <strong>"Thêm môn dạy"</strong> để bắt đầu.</td></tr>';
                }
            })
            .catch(err => {
                loading.style.display = 'none';
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger">Lỗi khi tải danh sách môn: ${err}</td></tr>`;
            });
    }

    function renderLecturerSubjectsTable(items) {
        const tbody = document.getElementById('lsTableBody');
        tbody.innerHTML = '';

        items.forEach((item, index) => {
            const tr = document.createElement('tr');
            const dateStr = item.registeredAt ? new Date(item.registeredAt).toLocaleDateString('vi-VN') : '-';

            const subCode = getVal(item, 'subjectCode', 'SubjectCode');
            const subName = getVal(item, 'subjectName', 'SubjectName');
            const subCredits = getVal(item, 'credits', 'Credits', 0);
            const notes = getVal(item, 'notes', 'Notes');
            const majorCode = getVal(item, 'majorCode', 'MajorCode') || getVal(item, 'majorName', 'MajorName');
            const specCode = getVal(item, 'specializationCode', 'SpecializationCode');
            const specName = getVal(item, 'specializationName', 'SpecializationName');
            const majorId = getVal(item, 'majorId', 'MajorId', 0);
            const specId = getVal(item, 'specializationId', 'SpecializationId', 0);
            const subjectId = getVal(item, 'subjectId', 'SubjectId', 0);
            const regId = getVal(item, 'id', 'Id', 0);

            const specDisplay = specName 
                ? `<span class="badge bg-info-subtle text-info border border-info">${specCode || ''}</span> <small class="text-dark">${specName}</small>` 
                : '<span class="text-muted small">Cơ sở ngành</span>';

            tr.innerHTML = `
                <td class="text-center text-muted">${index + 1}</td>
                <td class="fw-bold text-primary">${subCode}</td>
                <td>
                    <div class="fw-semibold text-dark">${subName}</div>
                    ${notes ? `<small class="text-muted fst-italic">${notes}</small>` : ''}
                </td>
                <td class="text-center"><span class="badge bg-light text-dark border">${subCredits}</span></td>
                <td><span class="badge bg-secondary-subtle text-secondary border border-secondary">${majorCode || '-'}</span></td>
                <td>${specDisplay}</td>
                <td class="text-center small text-muted">${dateStr}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-warning btn-sm rounded-3 me-1" 
                            onclick="openEditSubjectForm(${regId}, ${majorId}, ${specId}, ${subjectId}, '${notes.replace(/'/g, "\\'")}')"
                            title="Sửa môn đăng ký">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3" 
                            onclick="deleteLecturerSubject(${regId}, '${subCode}')"
                            title="Xóa môn đăng ký">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function openAddSubjectForm() {
        document.getElementById('formSubjectTitle').innerHTML = '<i class="fa-solid fa-book-bookmark me-1"></i>Đăng ký Môn Dạy Mới';
        document.getElementById('subRegId').value = '0';
        document.getElementById('subRegNotes').value = '';
        initMajorDropdown();
        document.getElementById('formSubjectContainer').style.display = 'block';
    }

    function openEditSubjectForm(id, majorId, specId, subjectId, notes) {
        document.getElementById('formSubjectTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-1"></i>Cập nhật Môn Đăng Ký';
        document.getElementById('subRegId').value = id;
        document.getElementById('subRegNotes').value = notes || '';

        initMajorDropdown(majorId);
        if (majorId) {
            onMajorChange(specId);
            if (specId) {
                onSpecializationChange(subjectId);
            }
        }

        document.getElementById('formSubjectContainer').style.display = 'block';
    }

    function closeSubjectForm() {
        document.getElementById('formSubjectContainer').style.display = 'none';
        document.getElementById('formLecturerSubject').reset();
        document.getElementById('subRegId').value = '0';
    }

    function initMajorDropdown(selectedMajorId = 0) {
        const majorSelect = document.getElementById('subRegMajor');
        majorSelect.innerHTML = '<option value="">-- 1. Chọn Ngành --</option>';

        allMajors.forEach(m => {
            const mId = getVal(m, 'id', 'Id');
            const mCode = getVal(m, 'code', 'Code');
            const mName = getVal(m, 'name', 'Name');
            const opt = document.createElement('option');
            opt.value = mId;
            opt.textContent = `${mCode} - ${mName}`;
            if (parseInt(mId) === parseInt(selectedMajorId)) opt.selected = true;
            majorSelect.appendChild(opt);
        });

        const specSelect = document.getElementById('subRegSpecialization');
        specSelect.innerHTML = '<option value="">-- Vui lòng chọn Ngành trước --</option>';
        specSelect.disabled = true;

        const subSelect = document.getElementById('subRegSubject');
        subSelect.innerHTML = '<option value="">-- Vui lòng chọn Ngành hẹp trước --</option>';
        subSelect.disabled = true;
    }

    function onMajorChange(selectedSpecId = 0) {
        const majorId = parseInt(document.getElementById('subRegMajor').value) || 0;
        const specSelect = document.getElementById('subRegSpecialization');
        const subSelect = document.getElementById('subRegSubject');

        specSelect.innerHTML = '<option value="">-- 2. Chọn Ngành hẹp --</option>';
        subSelect.innerHTML = '<option value="">-- Vui lòng chọn Ngành hẹp trước --</option>';
        subSelect.disabled = true;

        if (!majorId) {
            specSelect.disabled = true;
            return;
        }

        // Lọc các ngành hẹp thuộc ngành đã chọn
        const specs = allSpecializations.filter(sp => parseInt(getVal(sp, 'majorId', 'MajorId')) === majorId);
        if (specs.length === 0) {
            specSelect.innerHTML = '<option value="">-- Ngành này không có ngành hẹp --</option>';
            specSelect.disabled = true;
            return;
        }

        specs.forEach(sp => {
            const spId = getVal(sp, 'id', 'Id');
            const spCode = getVal(sp, 'code', 'Code');
            const spName = getVal(sp, 'name', 'Name');
            const opt = document.createElement('option');
            opt.value = spId;
            opt.textContent = `${spCode} - ${spName}`;
            if (parseInt(spId) === parseInt(selectedSpecId)) opt.selected = true;
            specSelect.appendChild(opt);
        });

        specSelect.disabled = false;
    }

    function onSpecializationChange(selectedSubjectId = 0) {
        const majorId = parseInt(document.getElementById('subRegMajor').value) || 0;
        const specId = parseInt(document.getElementById('subRegSpecialization').value) || 0;
        const subSelect = document.getElementById('subRegSubject');

        subSelect.innerHTML = '<option value="">-- 3. Chọn Môn học --</option>';

        if (!specId) {
            subSelect.disabled = true;
            return;
        }

        // Sổ ra các môn có trong chuyên ngành hẹp đó (hoặc môn của ngành đó)
        const subjects = allSubjects.filter(s => {
            const sSpecId = parseInt(getVal(s, 'specializationId', 'SpecializationId')) || 0;
            const sMajorId = parseInt(getVal(s, 'majorId', 'MajorId')) || 0;
            return (sSpecId === specId) || (sMajorId === majorId);
        });

        if (subjects.length === 0) {
            subSelect.innerHTML = '<option value="">-- Không có môn học nào thuộc chuyên ngành này --</option>';
            subSelect.disabled = true;
            return;
        }

        subjects.forEach(s => {
            const sId = getVal(s, 'id', 'Id');
            const sCode = getVal(s, 'code', 'Code');
            const sName = getVal(s, 'name', 'Name');
            const sCredits = getVal(s, 'credits', 'Credits', 3);
            const opt = document.createElement('option');
            opt.value = sId;
            opt.textContent = `${sCode} - ${sName} (${sCredits} TC)`;
            if (parseInt(sId) === parseInt(selectedSubjectId)) opt.selected = true;
            subSelect.appendChild(opt);
        });

        subSelect.disabled = false;
    }

    function submitLecturerSubject(event) {
        event.preventDefault();

        const majorId = parseInt(document.getElementById('subRegMajor').value) || 0;
        const specId = parseInt(document.getElementById('subRegSpecialization').value) || 0;
        const subjectId = parseInt(document.getElementById('subRegSubject').value) || 0;
        const id = parseInt(document.getElementById('subRegId').value) || 0;
        const notes = document.getElementById('subRegNotes').value.trim();
        const targetLecturerId = currentLecturerId > 0 ? currentLecturerId : currentUserId;

        // Validation: sau khi chọn xong mới cho thêm, không thì phải in ra thông báo
        if (!majorId || !specId || !subjectId) {
            alert('Vui lòng chọn đầy đủ Ngành, Ngành hẹp và Môn học trước khi tiếp tục!');
            return;
        }

        const btn = document.getElementById('btnSaveSubject');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        const isUpdate = (id > 0);
        const url = isUpdate ? '/Operations/UpdateLecturerSubject' : '/Operations/AddLecturerSubject';
        const payload = isUpdate 
            ? { id: id, lecturerId: targetLecturerId, majorId: majorId, specializationId: specId, subjectId: subjectId, notes: notes }
            : { lecturerId: targetLecturerId, majorId: majorId, specializationId: specId, subjectId: subjectId, notes: notes };

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(res => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu môn dạy';
            if (res.success) {
                alert(isUpdate ? 'Cập nhật môn đăng ký thành công!' : 'Thêm môn dạy đăng ký thành công!');
                closeSubjectForm();
                loadLecturerSubjects();
            } else {
                alert('Lỗi: ' + (res.message || 'Không thể lưu môn đăng ký.'));
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i>Lưu môn dạy';
            alert('Lỗi kết nối: ' + err);
        });
    }

    function deleteLecturerSubject(subjectRegId, subjectCode) {
        if (!confirm(`Bạn có chắc chắn muốn xóa môn '${subjectCode}' khỏi danh sách đăng ký của giảng viên này?`)) {
            return;
        }

        const targetLecturerId = currentLecturerId > 0 ? currentLecturerId : currentUserId;
        fetch(`/Operations/DeleteLecturerSubject?lecturerId=${targetLecturerId}&subjectRegId=${subjectRegId}`, {
            method: 'POST'
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                alert(res.message || 'Đã xóa môn đăng ký thành công!');
                loadLecturerSubjects();
            } else {
                alert('Không thể xóa: ' + (res.message || 'Môn học đang có ràng buộc dữ liệu.'));
            }
        })
        .catch(err => {
            alert('Lỗi kết nối khi xóa: ' + err);
        });
    }
</script>
}
