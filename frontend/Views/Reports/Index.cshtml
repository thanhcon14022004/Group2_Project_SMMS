@model List<project_PRN232.Frontend.Models.TranscriptViewModel>
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userRole = (string?)ViewBag.UserRole ?? HttpContextAccessor.HttpContext?.Session.GetString("SMMS_USER_ROLE") ?? "Admin";
    bool isLecturer = userRole == "Lecturer";
    ViewData["Title"] = isLecturer ? "Báo cáo Điểm Lớp Học phần" : "Báo cáo Thống kê & Điểm GPA";

    var majors = (List<project_PRN232.Frontend.Models.MajorViewModel>)ViewBag.Majors ?? new();
    var classes = (List<project_PRN232.Frontend.Models.ClassViewModel>)ViewBag.Classes ?? new();

    // Dành cho Giảng viên
    var sections = (List<project_PRN232.Frontend.Models.CourseSectionViewModel>)ViewBag.Sections ?? new();
    int? selectedSectionId = ViewBag.SelectedSectionId as int?;
    var gradeSheet = ViewBag.GradeSheet as project_PRN232.Frontend.Models.GradeSheetViewModel;
}

@if (isLecturer)
{
    <!-- ========================================== -->
    <!-- GIAO DIỆN BÁO CÁO ĐIỂM LỚP DÀNH CHO GIẢNG VIÊN -->
    <!-- ========================================== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h5 class="fw-bold mb-0 text-primary">
                <i class="fa-solid fa-chart-column me-2"></i>Báo cáo Điểm Lớp Học phần
            </h5>
            <small class="text-muted">Thống kê phổ điểm, tỷ lệ đạt/trượt và xuất bảng điểm chi tiết các lớp được phân công</small>
        </div>
        @if (selectedSectionId.HasValue && selectedSectionId.Value > 0)
        {
            <div class="d-flex gap-2">
                <a asp-controller="Grades" asp-action="Index" asp-route-sectionId="@selectedSectionId" class="btn btn-outline-primary btn-sm rounded-3 shadow-sm">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Vào sổ nhập điểm
                </a>
                <a asp-action="ExportSectionGradesCsv" asp-route-sectionId="@selectedSectionId" class="btn btn-success btn-sm rounded-3 shadow-sm text-white">
                    <i class="fa-solid fa-file-csv me-1"></i> Xuất Báo cáo CSV
                </a>
            </div>
        }
    </div>

    <!-- Thanh chọn Lớp học phần phụ trách -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-3 col-lg-2 fw-semibold text-secondary">
                    <i class="fa-solid fa-chalkboard-user me-1 text-primary"></i> Lớp học phần:
                </div>
                <div class="col-md-7 col-lg-8">
                    <select name="sectionId" class="form-select" onchange="this.form.submit()">
                        @if (!sections.Any())
                        {
                            <option value="">-- Bạn hiện chưa được phân công lớp học phần nào --</option>
                        }
                        else
                        {
                            @foreach (var sec in sections)
                            {
                                <option value="@sec.Id" selected="@(selectedSectionId == sec.Id ? "selected" : null)">
                                    @sec.Code - @sec.SubjectCode (@sec.SubjectName) @(sec.IsGradeLocked ? "[ĐÃ KHÓA ĐIỂM]" : "[ĐANG MỞ]")
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 shadow-sm">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Xem báo cáo
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!sections.Any())
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3 py-4 text-center">
            <i class="fa-solid fa-circle-info fa-2x text-primary mb-2"></i>
            <h6 class="fw-bold">Bạn chưa được phân công lớp học phần nào</h6>
            <p class="text-muted mb-0 small">Vui lòng liên hệ Phòng Đào tạo (Admin) để được phân công giảng dạy các lớp học phần trong học kỳ.</p>
        </div>
    }
    else if (gradeSheet == null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 py-4 text-center">
            <i class="fa-solid fa-triangle-exclamation fa-2x text-warning mb-2"></i>
            <h6 class="fw-bold">Chưa tải được dữ liệu điểm của lớp này</h6>
            <p class="text-muted mb-0 small">Vui lòng chọn lớp học phần từ danh sách trên để xem báo cáo chi tiết.</p>
        </div>
    }
    else
    {
        var studentRows = gradeSheet.StudentRows ?? new();
        int totalStudents = studentRows.Count;
        int gradedStudents = studentRows.Count(r => r.FinalScore.HasValue);
        int passedStudents = studentRows.Count(r => r.IsPassed);
        int failedStudents = gradedStudents - passedStudents;
        double passRate = gradedStudents > 0 ? Math.Round((double)passedStudents * 100.0 / gradedStudents, 1) : 0;
        double failRate = gradedStudents > 0 ? Math.Round((double)failedStudents * 100.0 / gradedStudents, 1) : 0;
        decimal avgFinal = gradedStudents > 0 ? Math.Round(studentRows.Where(r => r.FinalScore.HasValue).Average(r => r.FinalScore!.Value), 2) : 0m;
        decimal maxScore = gradedStudents > 0 ? studentRows.Where(r => r.FinalScore.HasValue).Max(r => r.FinalScore!.Value) : 0m;
        decimal minScore = gradedStudents > 0 ? studentRows.Where(r => r.FinalScore.HasValue).Min(r => r.FinalScore!.Value) : 0m;

        int countXuatSac = studentRows.Count(r => r.FinalScore >= 9.0m);
        int countGioi = studentRows.Count(r => r.FinalScore >= 8.0m && r.FinalScore < 9.0m);
        int countKha = studentRows.Count(r => r.FinalScore >= 6.5m && r.FinalScore < 8.0m);
        int countTrungBinh = studentRows.Count(r => r.FinalScore >= 5.0m && r.FinalScore < 6.5m);
        int countTruot = studentRows.Count(r => r.FinalScore.HasValue && r.FinalScore < 5.0m);

        <!-- Thống kê tổng quan dạng Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white border-start border-primary border-4">
                    <small class="text-muted fw-semibold">Sĩ số sinh viên lớp</small>
                    <div class="d-flex align-items-baseline justify-content-between mt-2">
                        <h3 class="fw-bold text-primary mb-0">@totalStudents</h3>
                        <small class="text-secondary">@gradedStudents đã có tổng kết</small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white border-start border-info border-4">
                    <small class="text-muted fw-semibold">Điểm TB môn học</small>
                    <div class="d-flex align-items-baseline justify-content-between mt-2">
                        <h3 class="fw-bold text-info mb-0">@avgFinal.ToString("0.00")</h3>
                        <small class="text-muted">Cao: <strong class="text-success">@maxScore</strong> | Thấp: <strong class="text-danger">@minScore</strong></small>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white border-start border-success border-4">
                    <small class="text-muted fw-semibold">Tỷ lệ Đạt (Pass)</small>
                    <div class="d-flex align-items-baseline justify-content-between mt-2">
                        <h3 class="fw-bold text-success mb-0">@passRate%</h3>
                        <span class="badge bg-success-subtle text-success">@passedStudents SV đạt</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white border-start @(gradeSheet.IsGradeLocked ? "border-danger" : "border-warning") border-4">
                    <small class="text-muted fw-semibold">Trạng thái Khóa điểm</small>
                    <div class="d-flex align-items-baseline justify-content-between mt-2">
                        <h6 class="fw-bold @(gradeSheet.IsGradeLocked ? "text-danger" : "text-warning") mb-0">
                            <i class="fa-solid @(gradeSheet.IsGradeLocked ? "fa-lock" : "fa-lock-open") me-1"></i>
                            @(gradeSheet.IsGradeLocked ? "Đã khóa điểm" : "Đang mở sửa")
                        </h6>
                        <span class="badge @(failedStudents > 0 ? "bg-danger-subtle text-danger" : "bg-light text-muted")">
                            @failedStudents SV trượt (@failRate%)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Phổ điểm phân bố -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-chart-pie me-2 text-primary"></i>Phổ điểm Lớp học phần (@(gradeSheet.CourseSectionCode) - @(gradeSheet.SubjectName))
                </h6>
            </div>
            <div class="card-body pt-0">
                <div class="row g-2 text-center mb-3">
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <small class="text-muted d-block">Xuất sắc (≥ 9.0)</small>
                            <strong class="text-primary fs-5">@countXuatSac</strong>
                            <small class="text-muted d-block">(@(gradedStudents > 0 ? Math.Round((double)countXuatSac * 100 / gradedStudents, 1) : 0)%)</small>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <small class="text-muted d-block">Giỏi (8.0 - 8.9)</small>
                            <strong class="text-success fs-5">@countGioi</strong>
                            <small class="text-muted d-block">(@(gradedStudents > 0 ? Math.Round((double)countGioi * 100 / gradedStudents, 1) : 0)%)</small>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <small class="text-muted d-block">Khá (6.5 - 7.9)</small>
                            <strong class="text-info fs-5">@countKha</strong>
                            <small class="text-muted d-block">(@(gradedStudents > 0 ? Math.Round((double)countKha * 100 / gradedStudents, 1) : 0)%)</small>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <small class="text-muted d-block">Trung bình (5.0 - 6.4)</small>
                            <strong class="text-warning fs-5">@countTrungBinh</strong>
                            <small class="text-muted d-block">(@(gradedStudents > 0 ? Math.Round((double)countTrungBinh * 100 / gradedStudents, 1) : 0)%)</small>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 rounded bg-light border">
                            <small class="text-muted d-block">Trượt môn (&lt; 5.0)</small>
                            <strong class="text-danger fs-5">@countTruot</strong>
                            <small class="text-muted d-block">(@(gradedStudents > 0 ? Math.Round((double)countTruot * 100 / gradedStudents, 1) : 0)%)</small>
                        </div>
                    </div>
                </div>

                <!-- Thanh biểu đồ phổ điểm nhiều màu -->
                @if (gradedStudents > 0)
                {
                    <div class="progress" style="height: 14px;">
                        @if (countXuatSac > 0)
                        {
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @((double)countXuatSac * 100 / gradedStudents)%" title="Xuất sắc: @countXuatSac"></div>
                        }
                        @if (countGioi > 0)
                        {
                            <div class="progress-bar bg-success" role="progressbar" style="width: @((double)countGioi * 100 / gradedStudents)%" title="Giỏi: @countGioi"></div>
                        }
                        @if (countKha > 0)
                        {
                            <div class="progress-bar bg-info" role="progressbar" style="width: @((double)countKha * 100 / gradedStudents)%" title="Khá: @countKha"></div>
                        }
                        @if (countTrungBinh > 0)
                        {
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @((double)countTrungBinh * 100 / gradedStudents)%" title="Trung bình: @countTrungBinh"></div>
                        }
                        @if (countTruot > 0)
                        {
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @((double)countTruot * 100 / gradedStudents)%" title="Trượt: @countTruot"></div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Bảng điểm chi tiết lớp học phần -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="fa-solid fa-table-list me-2 text-primary"></i>Bảng điểm Chi tiết Sinh viên trong Lớp
                </h6>
                <span class="badge bg-light text-dark border">@totalStudents sinh viên</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;" class="text-center">#</th>
                                <th style="width: 110px;">MSSV</th>
                                <th style="width: 200px;">Họ và tên</th>
                                <th style="width: 120px;">Lớp HC</th>
                                @foreach (var comp in gradeSheet.Components.OrderBy(c => c.OrderIndex))
                                {
                                    <th class="text-center" style="min-width: 90px;">
                                        <div>@comp.Name</div>
                                        <small class="text-muted fw-normal">(@comp.Weight%)</small>
                                    </th>
                                }
                                <th class="text-center bg-primary-subtle text-primary fw-bold" style="width: 120px;">Điểm tổng kết</th>
                                <th class="text-center" style="width: 110px;">Kết quả</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!studentRows.Any())
                            {
                                <tr>
                                    <td colspan="@(5 + gradeSheet.Components.Count)" class="text-center py-4 text-muted">
                                        Lớp học phần này hiện chưa có sinh viên đăng ký.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int idx = 1;
                                foreach (var row in studentRows)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@(idx++)</td>
                                        <td class="fw-bold text-primary">@row.StudentCode</td>
                                        <td class="fw-semibold">@row.FullName</td>
                                        <td><span class="badge bg-light text-dark border">@(string.IsNullOrWhiteSpace(row.AdministrativeClassCode) ? "-" : row.AdministrativeClassCode)</span></td>
                                        @foreach (var comp in gradeSheet.Components.OrderBy(c => c.OrderIndex))
                                        {
                                            row.ComponentScores.TryGetValue(comp.Id, out var score);
                                            <td class="text-center">
                                                @(score.HasValue ? score.Value.ToString("0.0") : "-")
                                            </td>
                                        }
                                        <td class="text-center fw-bold fs-6 @(row.FinalScore.HasValue ? (row.IsPassed ? "text-success bg-success-subtle" : "text-danger bg-danger-subtle") : "text-muted")">
                                            @(row.FinalScore.HasValue ? row.FinalScore.Value.ToString("0.0") : "Chưa có")
                                        </td>
                                        <td class="text-center">
                                            @if (!row.FinalScore.HasValue)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">Chưa đủ điểm</span>
                                            }
                                            else if (row.IsPassed)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success"><i class="fa-solid fa-check me-1"></i>ĐẠT</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger"><i class="fa-solid fa-xmark me-1"></i>TRƯỢT</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- ========================================== -->
    <!-- GIAO DIỆN BÁO CÁO GPA TOÀN TRƯỜNG DÀNH CHO ADMIN -->
    <!-- ========================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-0">Báo cáo Kết quả Học tập & GPA</h5>
            <small class="text-muted">Tổng hợp kết quả học tập toàn trường, lọc theo ngành và lớp chuyên ngành</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportGpaCsv" asp-route-majorId="@Context.Request.Query["majorId"]" asp-route-classId="@Context.Request.Query["classId"]" class="btn btn-outline-success btn-sm rounded-3">
                <i class="fa-solid fa-file-csv me-1"></i> Xuất Báo cáo CSV
            </a>
            <a asp-action="ExportGpaWord" asp-route-majorId="@Context.Request.Query["majorId"]" asp-route-classId="@Context.Request.Query["classId"]" class="btn btn-outline-primary btn-sm rounded-3">
                <i class="fa-solid fa-file-word me-1"></i> Xuất Báo cáo Word
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Lọc theo Ngành đào tạo</label>
                    <select name="majorId" class="form-select">
                        <option value="">-- Tất cả ngành học --</option>
                        @foreach (var m in majors)
                        {
                            <option value="@m.Id" selected="@(Context.Request.Query["majorId"] == m.Id.ToString() ? "selected" : null)">
                                @m.Code - @m.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Lọc theo Lớp hành chính</label>
                    <select name="classId" class="form-select">
                        <option value="">-- Tất cả các lớp --</option>
                        @foreach (var c in classes)
                        {
                            <option value="@c.Id" selected="@(Context.Request.Query["classId"] == c.Id.ToString() ? "selected" : null)">
                                @c.Code (@c.Name) - K@(c.Cohort)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3">
                        <i class="fa-solid fa-filter me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <small class="text-muted fw-semibold">Tổng số Sinh viên trong danh sách</small>
                <h3 class="fw-bold text-primary mt-1 mb-0">@(Model?.Count ?? 0)</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <small class="text-muted fw-semibold">Điểm GPA Trung bình</small>
                <h3 class="fw-bold text-success mt-1 mb-0">
                    @(Model != null && Model.Any() ? Model.Average(m => m.CumulativeGpa).ToString("0.00") : "0.00")
                </h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <small class="text-muted fw-semibold">Sinh viên Xuất sắc & Giỏi</small>
                <h3 class="fw-bold text-info mt-1 mb-0">
                    @(Model?.Count(m => m.AcademicStanding == "Xuất sắc" || m.AcademicStanding == "Giỏi") ?? 0)
                </h3>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold mb-0"><i class="fa-solid fa-graduation-cap me-2 text-primary"></i>Danh sách Chi tiết Điểm & Xếp loại</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">STT</th>
                            <th>MSSV</th>
                            <th>Họ và tên</th>
                            <th>Ngành</th>
                            <th>Chuyên ngành</th>
                            <th class="text-center">Số TC Đăng ký</th>
                            <th class="text-center">Số TC Đạt</th>
                            <th class="text-center">GPA Thang 10</th>
                            <th class="text-center">Xếp loại</th>
                            <th class="text-end" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">Không tìm thấy sinh viên nào theo tiêu chí đã chọn.</td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            foreach (var s in Model)
                            {
                                <tr>
                                    <td class="text-muted">@(idx++)</td>
                                    <td class="fw-bold">@s.StudentCode</td>
                                    <td>@s.FullName</td>
                                    <td><span class="badge bg-light text-dark border">@s.MajorName</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(s.SpecializationName) ? "-" : s.SpecializationName)</td>
                                    <td class="text-center">@s.TotalEnrolledCredits</td>
                                    <td class="text-center fw-semibold text-success">@s.TotalPassedCredits</td>
                                    <td class="text-center fw-bold fs-6 text-primary">@s.CumulativeGpa.ToString("0.00")</td>
                                    <td class="text-center">
                                        @if (s.AcademicStanding == "Xuất sắc")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Xuất sắc</span>
                                        }
                                        else if (s.AcademicStanding == "Giỏi")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Giỏi</span>
                                        }
                                        else if (s.AcademicStanding == "Khá")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary">Khá</span>
                                        }
                                        else if (s.AcademicStanding == "Trung bình")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning">Trung bình</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary">@s.AcademicStanding</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Grades" asp-action="Transcript" asp-route-studentId="@s.StudentId" class="btn btn-outline-primary btn-sm rounded-3">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
